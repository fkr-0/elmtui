(defpackage :elmtui.workbench.eval (:use :cl) (:export #:make-repl-session #:request-evaluation #:poll-evaluation #:cancel-evaluation #:close-repl-session #:repl-session-package #:repl-session-readtable))
(in-package :elmtui.workbench.eval)
(define-condition evaluation-aborted (condition) ())
(defstruct (eval-job (:constructor %make-eval-job (id source))) id source (cancelled nil))
(defstruct (repl-session (:constructor %make-repl-session)) (package (find-package :cl-user)) (readtable (copy-readtable nil)) (mutex (sb-thread:make-mutex :name "workbench eval mutex")) (wake (sb-thread:make-waitqueue :name "workbench eval wake")) (pending nil) (events nil) (active nil) (jobs (make-hash-table :test 'equal)) (used-ids (make-hash-table :test 'equal)) (worker nil) (closed nil) (last-form nil) (form-one nil) (form-two nil) (form-three nil) (value-one nil) (value-two nil) (value-three nil) (values-one nil) (values-two nil) (values-three nil))
(defun %emit (session id type &rest properties) (sb-thread:with-mutex ((repl-session-mutex session)) (push (list* :type type :request-id id properties) (repl-session-events session))))
(defun %flush-captured (session id stdout stderr) (let ((out (get-output-stream-string stdout)) (err (get-output-stream-string stderr))) (unless (zerop (length out)) (%emit session id :stdout :text out)) (unless (zerop (length err)) (%emit session id :stderr :text err))))
(defun %cancelled-p (session job) (sb-thread:with-mutex ((repl-session-mutex session)) (eval-job-cancelled job)))
(defun %display-value (value) (handler-case (let ((*print-circle* t) (*print-level* 6) (*print-length* 24) (*print-readably* nil)) (prin1-to-string value)) (error (condition) (format nil "#<PRINT-ERROR ~a>" (type-of condition)))))
(defun %advance-history (session form values) (setf (repl-session-form-three session) (repl-session-form-two session) (repl-session-form-two session) (repl-session-form-one session) (repl-session-form-one session) form (repl-session-last-form session) form (repl-session-value-three session) (repl-session-value-two session) (repl-session-value-two session) (repl-session-value-one session) (repl-session-value-one session) (first values) (repl-session-values-three session) (repl-session-values-two session) (repl-session-values-two session) (repl-session-values-one session) (repl-session-values-one session) values))
(defun %finish (session job status) (sb-thread:with-mutex ((repl-session-mutex session)) (remhash (eval-job-id job) (repl-session-jobs session)) (setf (repl-session-active session) nil) (push (list :type :finished :request-id (eval-job-id job) :status status) (repl-session-events session))))
(defun %run-request (session job) (let* ((*package* (repl-session-package session)) (*readtable* (repl-session-readtable session)) (* (repl-session-value-one session)) (** (repl-session-value-two session)) (*** (repl-session-value-three session)) (+ (repl-session-form-one session)) (++ (repl-session-form-two session)) (+++ (repl-session-form-three session)) (- (repl-session-last-form session)) (/ (repl-session-values-one session)) (// (repl-session-values-two session)) (/// (repl-session-values-three session)) (stdout (make-string-output-stream)) (stderr (make-string-output-stream)) (*standard-output* stdout) (*error-output* stderr) (*trace-output* stderr) (*debug-io* (make-two-way-stream (make-string-input-stream "") stderr)) (*query-io* *debug-io*) (status :ok)) (unwind-protect (handler-case (with-input-from-string (input (eval-job-source job)) (let ((eof (gensym))) (loop (when (%cancelled-p session job) (error 'evaluation-aborted)) (let ((form (read input nil eof))) (when (eq form eof) (return)) (when (%cancelled-p session job) (error 'evaluation-aborted)) (setf - form) (let ((values (multiple-value-list (eval form)))) (%flush-captured session (eval-job-id job) stdout stderr) (when (%cancelled-p session job) (error 'evaluation-aborted)) (%advance-history session form values) (setf *** ** ** * * (first values) +++ ++ ++ + + form /// // // / / values) (loop for value in values for index from 1 do (%emit session (eval-job-id job) :value :index index :count (length values) :text (%display-value value)))))))) (evaluation-aborted () (setf status :aborted) (%emit session (eval-job-id job) :aborted)) (error (condition) (setf status :error) (%flush-captured session (eval-job-id job) stdout stderr) (%emit session (eval-job-id job) :condition :text (princ-to-string condition) :condition-type (princ-to-string (type-of condition))))) (%flush-captured session (eval-job-id job) stdout stderr) (setf (repl-session-package session) *package* (repl-session-readtable session) *readtable*) (%finish session job status))))
(defun %worker-loop (session) (loop (let ((job nil)) (sb-thread:with-mutex ((repl-session-mutex session)) (loop while (and (null (repl-session-pending session)) (not (repl-session-closed session))) do (sb-thread:condition-wait (repl-session-wake session) (repl-session-mutex session))) (when (and (repl-session-closed session) (null (repl-session-pending session))) (return-from %worker-loop nil)) (setf job (pop (repl-session-pending session)) (repl-session-active session) job)) (%run-request session job))))
(defun make-repl-session (&key (package (find-package :cl-user)) (readtable (copy-readtable nil))) "Create isolated per-session serialized REPL worker. User EVAL is trusted." (let ((resolved (find-package package))) (unless resolved (error "Unknown REPL package ~s" package)) (let ((session (%make-repl-session :package resolved :readtable (copy-readtable readtable)))) (setf (repl-session-worker session) (sb-thread:make-thread (lambda () (%worker-loop session)) :name "elmtui workbench eval")) session)))
(defun request-evaluation (session source request-id) "Enqueue SOURCE under a session-unique REQUEST-ID; return its ID." (check-type source string) (sb-thread:with-mutex ((repl-session-mutex session)) (when (repl-session-closed session) (error "REPL session is closed")) (when (gethash request-id (repl-session-used-ids session)) (error "Duplicate evaluation request ID ~s" request-id)) (let ((job (%make-eval-job request-id (copy-seq source)))) (setf (gethash request-id (repl-session-used-ids session)) t (gethash request-id (repl-session-jobs session)) job (repl-session-pending session) (nconc (repl-session-pending session) (list job))) (sb-thread:condition-notify (repl-session-wake session)) request-id)))
(defun poll-evaluation (session) "Nonblocking drain of chronological plists with :TYPE and :REQUEST-ID." (sb-thread:with-mutex ((repl-session-mutex session)) (prog1 (nreverse (repl-session-events session)) (setf (repl-session-events session) nil))))
(defun cancel-evaluation (session request-id) "Cooperative only: queued work is skipped; running EVAL is not interrupted. Already running forms can have side effects, block indefinitely, and only report :ABORTED once they return." (sb-thread:with-mutex ((repl-session-mutex session)) (let ((job (gethash request-id (repl-session-jobs session)))) (when job (setf (eval-job-cancelled job) t) t))))
(defun close-repl-session (session) "Request cooperative shutdown, never waiting for arbitrary Lisp user EVAL." (sb-thread:with-mutex ((repl-session-mutex session)) (setf (repl-session-closed session) t) (dolist (job (repl-session-pending session)) (setf (eval-job-cancelled job) t)) (when (repl-session-active session) (setf (eval-job-cancelled (repl-session-active session)) t)) (sb-thread:condition-notify (repl-session-wake session)) t))

