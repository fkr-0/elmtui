(uiop:define-package :elmtui.view.layout.size-utils
  (:use :cl)
  (:import-from :elmtui.view.geo
                #:size #:make-size #:size-w #:size-h #:make-rectangle #:make-pos
                #:w #:h #:x #:y #:rectangle)
  (:import-from :elmtui.view.base-elements
                #:base-element #:element-props #:element-style)
  (:export
   #:measure-node-intrinsic-size
   #:content-rect-of
   #:compute-size))

(in-package :elmtui.view.layout.size-utils)

(defun style-value (node key &optional default)
  (getf (element-style node) key default))

(defun percentp (x)
  (and (stringp x)
       (> (length x) 1)
       (char= #\% (char x (1- (length x))))))

(defun percent-of (s total)
  (when (percentp s)
    (* (/ (parse-integer s :end (1- (length s))) 100.0)
       (max 0 total))))

(defun clamp (v lo hi)
  (max lo (min v hi)))

(defun num-or-nil (v)
  (and (numberp v) v))

(defparameter *default-root-content-size* (make-size :w 80 :h 24))

(defun num+ (x) (and (numberp x) (>= x 0) x))

(defun infer-parent-content-size (el)
  (let* ((props (element-props el))
         (existing (getf props :layout-rect))
         (sw (num+ (getf (element-style el) :width)))
         (sh (num+ (getf (element-style el) :height))))
    (cond
      ((typep existing 'rectangle)
       (make-size :w (w existing) :h (h existing)))
      ((and sw sh) (make-size :w sw :h sh))
      (t *default-root-content-size*))))

(defun measure-node-intrinsic-size (node container-w container-h)
  (declare (ignore container-h))
  (labels ((pct (v total)
             (when (and (stringp v) (plusp (length v)) (char= (char v (1- (length v))) #\%))
               (* (/ (parse-integer v :end (1- (length v))) 100.0) (max 0 total)))))
    (let* ((mw (or (style-value node :min-width 0) 0))
           (Mxw (or (style-value node :max-width most-positive-fixnum) most-positive-fixnum))
           (w (or (style-value node :width :auto) :auto))
           (mh (or (style-value node :min-height 0) 0))
           (Mxh (or (style-value node :max-height most-positive-fixnum) most-positive-fixnum))
           (h (or (style-value node :height :auto) :auto))
           (resolved-w (cond ((numberp w) w)
                             ((pct w container-w))
                             ((eq w :auto) mw)
                             ;; (t mw)
                             ))
           (resolved-h (cond ((numberp h) h)
                             ((pct h (if (and container-w (style-value node :aspect-ratio))
                                         (/ container-w (style-value node :aspect-ratio))
                                         container-w)))
                             ((eq h :auto) mh)
                             ;; (t mh)
                             )))
      (values (max 0 (min resolved-w Mxw))
              (if (numberp w) (max 0 (min w Mxw)) (max 0 Mxw))
              (max 0 (min resolved-h Mxh))
              (if (numberp h) (max 0 (min h Mxh)) (max 0 Mxh))))))

(defun compute-size* (node parent-content-width parent-content-height)
  (labels ((res (spec axis)
             (cond
               ((num-or-nil spec) spec)
               ((percentp spec)
                (if (eq axis :w)
                    (percent-of spec parent-content-width)
                    (percent-of spec parent-content-height)))
               (t :auto))))
    (let* ((sw (style-value node :width :auto))
           (sh (style-value node :height :auto))
           (minw (or (style-value node :min-width 0) 0))
           (maxw (or (style-value node :max-width most-positive-fixnum) most-positive-fixnum))
           (minh (or (style-value node :min-height 0) 0))
           (maxh (or (style-value node :max-height most-positive-fixnum) most-positive-fixnum))
           (rw (res sw :w))
           (rh (res sh :h)))
      (multiple-value-bind (mincw maxcw minch maxch)
          (measure-node-intrinsic-size node parent-content-width parent-content-height)
        (declare (ignore maxcw maxch))
        (let* ((w0 (if (eq rw :auto) (or mincw 0) rw))
               (h0 (if (eq rh :auto) (or minch 0) rh))
               (w (clamp w0 minw maxw))
               (h (clamp h0 minh maxh)))
          (values (round w) (round h)))))))

(defun compute-size (el &optional parent-content-size)
  (let* ((pcs (or parent-content-size
                  (infer-parent-content-size el))))
    (multiple-value-bind (w h)
        (compute-size* el (size-w pcs) (size-h pcs))
      (make-size :w w :h h))))

(defun content-rect-of (outer-rect styled-node)
  (let* ((pt (or (style-value styled-node :padding-top 0) 0))
         (pr (or (style-value styled-node :padding-right 0) 0))
         (pb (or (style-value styled-node :padding-bottom 0) 0))
         (pl (or (style-value styled-node :padding-left 0) 0))
         (bs (or (style-value styled-node :border-style :none) :none))
         (bw (if (eq bs :none) 0 (or (style-value styled-node :border-width 1) 1)))
         (bt (if (eq bs :none) 0 (or (style-value styled-node :border-top-width bw) bw)))
         (br (if (eq bs :none) 0 (or (style-value styled-node :border-right-width bw) bw)))
         (bb (if (eq bs :none) 0 (or (style-value styled-node :border-bottom-width bw) bw)))
         (bl (if (eq bs :none) 0 (or (style-value styled-node :border-left-width bw) bw)))
         (cx (+ (x outer-rect) pl bl))
         (cy (+ (y outer-rect) pt bt))
         (cw (max 0 (- (w outer-rect) pl pr bl br)))
         (ch (max 0 (- (h outer-rect) pt pb bt bb))))
    (make-rectangle :pos (make-pos :x cx :y cy)
                    :size (make-size :w cw :h ch))))
