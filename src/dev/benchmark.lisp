(uiop:define-package :elmtui.dev.benchmark (:use :cl) (:import-from :elmtui.core.event-pipeline #:make-pipeline #:process-event #:transform-pipe) (:import-from :elmtui.core.event-types #:normalize-key-event) (:export #:benchmark-thunk #:benchmark-event-throughput #:benchmark-input-normalization #:compare-benchmark-results #:stress-event-pipeline #:write-benchmark-baseline #:read-benchmark-baseline #:print-benchmark-result #:run-benchmark-suite))

(in-package :elmtui.dev.benchmark)

(defun %bytes-consed () "Return implementation allocation counter when available." (let* ((package (find-package "SB-EXT")) (symbol (and package (find-symbol "GET-BYTES-CONSED" package)))) (when (and symbol (fboundp symbol)) (funcall symbol))))

(defun benchmark-thunk (name thunk &key (iterations 10000) (warmup-iterations 1000)) "Benchmark THUNK and return a portable result plist." (check-type iterations (integer 1 *)) (check-type warmup-iterations (integer 0 *)) (dotimes (index warmup-iterations) (declare (ignorable index)) (funcall thunk)) (let ((bytes-before (%bytes-consed)) (started (get-internal-real-time))) (dotimes (index iterations) (declare (ignorable index)) (funcall thunk)) (let* ((finished (get-internal-real-time)) (bytes-after (%bytes-consed)) (elapsed (/ (- finished started) (float internal-time-units-per-second 1.0d0))) (ops (if (plusp elapsed) (/ iterations elapsed) 0.0d0)) (bytes (and bytes-before bytes-after (- bytes-after bytes-before)))) (list :name name :iterations iterations :elapsed-seconds elapsed :ops-per-second ops :ns-per-op (if (plusp ops) (/ 1.0d9 ops) 0.0d0) :bytes-consed bytes :bytes-per-op (and bytes (/ bytes (float iterations 1.0d0)))))))

(defun benchmark-event-throughput (&key (iterations 100000) (warmup-iterations 5000)) "Measure pure event-pipeline transform throughput." (let ((pipeline (make-pipeline :pipes (list (make-instance 'transform-pipe :transform (lambda (event) (1+ event))) (make-instance 'transform-pipe :transform (lambda (event) (* event 2))))))) (benchmark-thunk :event-pipeline (lambda () (process-event pipeline 41)) :iterations iterations :warmup-iterations warmup-iterations)))

(defun benchmark-input-normalization (&key (iterations 100000) (warmup-iterations 5000)) "Measure raw key-event normalization throughput." (let ((event ' (:type :key-down :key :arrow-down :code 0 :modifiers (:shift)))) (benchmark-thunk :input-normalization (lambda () (normalize-key-event event)) :iterations iterations :warmup-iterations warmup-iterations)))

(defun compare-benchmark-results (baseline candidate &key (minimum-ratio 0.90d0)) "Compare CANDIDATE throughput with BASELINE without imposing CI timing policy." (let* ((base (getf baseline :ops-per-second 0.0d0)) (current (getf candidate :ops-per-second 0.0d0)) (ratio (if (plusp base) (/ current base) 0.0d0))) (list :name (getf candidate :name) :baseline-ops-per-second base :candidate-ops-per-second current :ratio ratio :minimum-ratio minimum-ratio :passes (>= ratio minimum-ratio))))

(defun stress-event-pipeline (&key (rounds 5) (iterations 50000)) "Run repeated pipeline benchmarks and summarize throughput spread." (check-type rounds (integer 1 *)) (let* ((results (loop repeat rounds collect (benchmark-event-throughput :iterations iterations :warmup-iterations 1000))) (rates (sort (mapcar (lambda (result) (getf result :ops-per-second)) results) #'<)) (middle (nth (floor (length rates) 2) rates))) (list :rounds rounds :iterations-per-round iterations :minimum-ops-per-second (first rates) :median-ops-per-second middle :maximum-ops-per-second (car (last rates)) :results results)))

(defun write-benchmark-baseline (pathname results) "Write RESULTS as a readable Common Lisp baseline file." (with-open-file (stream pathname :direction :output :if-exists :supersede :if-does-not-exist :create) (with-standard-io-syntax (let ((*print-pretty* t) (*print-readably* t)) (write results :stream stream) (terpri stream)))) pathname)

(defun read-benchmark-baseline (pathname) "Read one benchmark baseline value from PATHNAME." (with-open-file (stream pathname :direction :input) (with-standard-io-syntax (read stream nil nil))))

(defun print-benchmark-result (result &optional (stream *standard-output*)) "Print one compact benchmark result line." (format stream "~A: ~,0F ops/s | ~,1F ns/op~@[ | ~,1F B/op~]~%" (getf result :name) (getf result :ops-per-second 0.0d0) (getf result :ns-per-op 0.0d0) (getf result :bytes-per-op)))

(defun run-benchmark-suite (&key (iterations 100000) (print-results t)) "Run the maintained developer microbenchmark suite and return result plists." (let ((results (list (benchmark-event-throughput :iterations iterations) (benchmark-input-normalization :iterations iterations)))) (when print-results (dolist (result results) (print-benchmark-result result))) results))
