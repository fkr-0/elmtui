;;; Platform Input Adapter
(uiop:define-package :elmtui.platform.input
  (:use :cl)
  (:import-from :log4cl #:log-debug #:log-warn #:log-info) ; Added log-info
  (:import-from :elmtui.core.threads
    #:with-interruptable-signal #:cond-message)
  (:import-from :elmtui.platform.api
    #:poll-input-event)
  (:import-from :elmtui.state.msg #:make-focusprevious-appmsg #:make-focusnext-appmsg
    )
  (:import-from :cl-inputs.tokens
    #:input-token-kind #:input-token-data)

  (:import-from :elmtui.core.event-types
    #:make-key-event #:make-mouse-event)
  (:import-from :elmtui.app.system-events
    #:make-terminalresized-systemevent)
  (:import-from :cl-inputs.terminal.ansii #:normalize-key-symbol #:%token-char)
  (:export :start-reader
    #:cl-inputs-token->event
    :stop-reader
    :request-stop-input-reader)) ; Assuming request-stop-input-reader might be a default name

(in-package :elmtui.platform.input)
(defun cl-inputs-token->event (token)
  "Convert a cl-inputs token to an elmtui event structure. Returns NIL when unsupported."
  (let* ((kind (input-token-kind token))
          (data (input-token-data token)))
    (case kind
      (:key
        (let* ((code (getf data :code))
                (mods (copy-list (getf data :mods)))
                (char (or (%token-char code) (getf data :char)))
                (key (normalize-key-symbol code))
                (type (or (getf data :type) :key-down))
                (code-value (cond ((integerp code) code)
                              ((characterp char) (char-code char))
                              (t nil))))
          (make-key-event
            :key key
            :char char
            :modifiers mods
            :type type
            :code code-value)))
      (:mouse
        (make-mouse-event
          :type (getf data :type)
          :button (getf data :button)
          :x (getf data :x)
          :y (getf data :y)
          :modifiers (copy-list (getf data :mods))))
      (:resize
        (let ((width (getf data :width))
               (height (getf data :height)))
          (when (and width height)
            (make-terminalresized-systemevent :width width :height height))))
      (t
        (log:debug "cl-inputs token ignored: ~S (~S)" kind data)
        nil))))
;; Default name for the function to stop the input reader thread.
;; This is used if with-interruptable-signal defines 'interrupt-reader-fn'
;; and start-reader returns this symbol.
;; (defvar *default-input-reader-stop-signal-name* 'interrupt-reader-fn
;;   "The default name for the function used to signal the input reader thread to stop.")

(defun start-reader (backend-instance &key event-handler)
  "Spawns a thread that continuously polls for input events from the BACKEND-INSTANCE
and publishes them using the provided EVENT-HANDLER.

Args:
  backend-instance: The initialized backend (e.g., terminal-instance) to poll for input.
  event-handler: A function to call with the polled event.

Returns:
  Multiple values: the thread object and the symbol name of the function
  generated by `with-interruptable-signal` to stop this reader thread (e.g., 'interrupt-reader-fn')."
  (unless event-handler
    (error "EVENT-HANDLER keyword argument is required for START-READER."))
  ;; (let* ((thread-and-interrupt
  ;;          (multiple-value-list
  (with-interruptable-signal ret-val ; ret-val is the optional 'returns' arg for the macro
    (loop
      (let ((event (poll-input-event backend-instance :timeout 0.1)))
        (when event
          (log:debug "INPUT: poll-input-event returned: ~S" event)
          (if (typep event 'elmtui.core.event-types:key-event)
            (let* ((key (elmtui.core.event-types:key-event-key event))
                    (modifiers (elmtui.core.event-types:key-event-modifiers event)))
              (cond
                ((and (eq key :tab) (member :shift modifiers :test #'eq))
                  (log:debug "INPUT: Publishing make-focus-previous-app-msg for Shift+Tab via event-handler")
                  (funcall event-handler (make-focusprevious-appmsg)))
                ((eq key :tab)
                  (log:debug "INPUT: Publishing make-focus-next-app-msg for Tab via event-handler")
                  (funcall event-handler (make-focusnext-appmsg)))
                (t
                  (log:debug "INPUT: Publishing key-event struct via event-handler: ~S" event)
                  (funcall event-handler event)
                  (setf ret-val (format nil "Last event: ~a" event))))) ; Publish original key-event struct
            (progn ; Event is not a key-event struct
              (log:info "INPUT: Publishing non-key-event struct via event-handler: ~S" event)
              (funcall event-handler event)))) ; Publish other event types
        (sb-thread:thread-yield)))))

;; Return a function that can be called to stop the reader

;; (apply #'values thread-and-interrupt)))

(defun stop-reader (stop-signal-function &optional thread-handle)
  "Stops the input reader thread.

Args:
  stop-signal-function: The function or symbol of the function generated by `with-interruptable-signal`
                        (e.g., 'interrupt-reader-fn) to signal the thread.
  thread-handle: Optional. The thread object returned by `start-reader`. If provided,
                 this function will attempt to join the thread after signaling.

Returns:
  T if the signal function was called, NIL otherwise."
  (declare (ignorable thread-handle))

  (if (symbolp stop-signal-function)
    ;; Handle case where a symbol was passed
    (if (fboundp stop-signal-function)
      (progn
        (log:info "INPUT: Calling stop-signal-function (symbol): ~S" stop-signal-function)
        (funcall (symbol-function stop-signal-function))
        t)
      (progn
        (log:warn "INPUT: stop-reader: Provided stop-signal-function symbol '~A' is not fboundp." stop-signal-function)
        nil))
    ;; Handle case where a function object was passed
    (if (functionp stop-signal-function)
      (progn
        (log:info "INPUT: Calling stop-signal-function (function object)")
        (funcall stop-signal-function)
        t)
      (progn
        (log:warn "INPUT: stop-reader: Provided stop-signal-function is neither a symbol nor a function: ~A" stop-signal-function)
        nil))))
