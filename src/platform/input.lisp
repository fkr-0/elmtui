;;;===============================================================
;;; File: src/platform/input.lisp
;;; Platform Input Adapter
(uiop:define-package :elmtui.platform.input
  (:use :cl
   :elmtui.core.loop
   ) ; Import for with-interruptable-signal
  (:import-from :elmtui.core.threads ; Assuming backend methods are in platform.api or specific backend package
                #:with-interruptable-signal #:cond-message)
  (:import-from :elmtui.platform.api ; Assuming backend methods are in platform.api or specific backend package
                #:poll-input-event)
  (:import-from :elmtui.state.msg #:make-focus-next-app-msg #:make-focus-previous-app-msg) ; For focus messages
  (:export :start-reader
   :stop-reader
           :request-stop-input-reader)) ; Export the generated signal function name
(in-package :elmtui.platform.input)

;;; This will be the default name for the function generated by with-interruptable-signal
;;; to stop the input reader thread.
(defvar *default-input-reader-stop-signal-name* 'request-stop-input-reader
  "The default name for the function used to signal the input reader thread to stop.")

(defun start-reader (backend-instance &key (stop-signal-name *default-input-reader-stop-signal-name*))
  "Spawns a thread that continuously polls for input events from the BACKEND-INSTANCE
and publishes them to the elmtui.core.loop.

Args:
  backend-instance: The initialized backend (e.g., terminal-instance) to poll for input.
  stop-signal-name: The symbol name for the function that will be generated by
                    `with-interruptable-signal` to stop this reader thread.
                    Defaults to `request-stop-input-reader`.

Returns:
  A cons cell: (thread-object . stop-signal-function-name)
  The thread-object is the thread running the input loop.
  The stop-signal-function-name is the symbol of the function to call to stop the thread."

  (let ((actual-stop-fn-name (if (symbolp stop-signal-name)
                                 stop-signal-name
                                 (error "stop-signal-name must be a symbol for the signal function."))))
    ;; with-interruptable-signal will define the function named by actual-stop-fn-name
    ;; and return (values thread-object symbol-of-signal-function)
    ;; The 'thread-return-value' here is the optional second arg to with-interruptable-signal,
    ;; naming a variable that will receive the payload if the thread is interrupted.
    (with-interruptable-signal actual-stop-fn-name thread-interrupt-payload
      ;; This body executes in the new thread.
      ;; The 'thread-handle' is not directly available here unless we capture sb-thread:*current-thread*
      ;; but the macro itself returns the thread object as its first value.
      (loop
        (let ((event (poll-input-event backend-instance :timeout 0.1)))
          (when event
            (if (and (listp event) (eq (first event) :key-event))
                (let* ((key-data (rest event))
                       (key (getf key-data :key))
                       (modifiers (getf key-data :modifiers)))
                  (cond
                    ((and (eq key :tab) (member :shift modifiers :test #'eq))
                     (elmtui.core.loop:publish (elmtui.state.msg::make-focus-previous-app-msg)))
                    ((eq key :tab)
                     (elmtui.core.loop:publish (elmtui.state.msg::make-focus-next-app-msg)))
                    (t (elmtui.core.loop:publish event)))) ; Publish original key event
                (elmtui.core.loop:publish event)))) ; Publish non-key event
        (sb-thread:thread-yield)))))

(defun stop-reader (stop-signal-function &optional thread-handle)
  "Stops the input reader thread.

Args:
  stop-signal-function: The symbol of the function generated by `with-interruptable-signal`
                        (e.g., 'request-stop-input-reader) to signal the thread.
  thread-handle: Optional. The thread object returned by `start-reader`. If provided,
                 this function will attempt to join the thread after signaling.

Returns:
  T if the signal function was called, NIL otherwise."
  (if (and stop-signal-function (fboundp stop-signal-function))
      (progn
        (funcall stop-signal-function)
        (when thread-handle
          ;; Add a timeout to prevent indefinite blocking if the thread doesn't terminate
          (handler-case (sb-thread:join-thread thread-handle :timeout 2)
            (sb-thread:join-thread-error (e)
              (progn (warn "Timeout joining input reader thread: ~A. Thread might not have terminated cleanly." e)
                     nil)) ; Indicate join timed out
            (error (e)
              (progn (warn "Error joining input reader thread: ~A" e) nil)
              ))) ; Indicate error during join
        t)
      (progn
        (warn "stop-reader: Provided stop-signal-function '~A' is not fboundp." stop-signal-function)
        nil)))
