(uiop:define-package :elmtui.ui.widgets.button
  (:use :cl :elmtui.ui.defcomponent )
  (:import-from :elmtui.ui.api
   :id-from-path :make-state-patch
   :with-update-patch :add-patch :add-command
                :get-path :set-path :remove-path
   :app-state)
  (:import-from :elmtui.state.api
                #:make-update-result
                )
  (:import-from :elmtui.view.styled #:make-styled-node)
  (:import-from :elmtui.core.async #:cmd #:cmd-payload) ; Assuming cmd-async might be simplified or part of a general cmd structure
  (:import-from :elmtui.core.events #:send-message) ; If still used directly for commands
  (:import-from :elmtui.state.msg :defmsg) ; For defining messages
  (:export #:button #:make-button ; Class name and constructor
           ;; Accessors (generated by defcomponent if specified)
           #:button-label #:button-on-click-msg #:button-disabled
           ;; Messages
           #:msg-button-click))

(in-package :elmtui.ui.widgets.button)
;; (defmethod cclass-name ((cmp (eql 'lurch)))
;;   "lurch")
;; Define component with its state properties
(defcomponent button ()
    ((label :accessor button-label :initform "Button")
     (on-click-msg :accessor button-on-click-msg :initform nil)
     (disabled :accessor button-disabled :initform nil :type boolean)))

;;;--------------------------------------------------------------
;;; Messages
;;;--------------------------------------------------------------
;; (elmtui.state.msg:defmsg msg-button-click :button-click "Message type for button click events.")

(defmsg ButtonMsg (:docstring "Messages for button interactions")
        ButtonClick)
;;;--------------------------------------------------------------
;;; Update
;;;--------------------------------------------------------------
(defmethod update ((component button) app-state msg &key id-path)
  (let ((component-id (id-from-path id-path)))
    (with-update-patch (app-state component)
      (case msg
        (:button-click

         (is-disabled (button-disabled app-state component)))
        (when (and on-click (not is-disabled))
          ;; Commands are now typically symbols or lists that the app's main update logic handles.
          ;; If send-message is still the way to dispatch, it would be wrapped in a command structure.
          ;; For now, let's assume on-click-msg is the command itself.
          (add-command on-click))))
    (otherwise
     ;; Potentially handle messages to set label, disable/enable, etc.
     ;; Example: (:set-label "New Label")
     (when (and (consp msg) (eq (first msg) :set-label) (second msg))
       (add-patch (make-state-patch `(:components ,component-id :label) (second msg))))
     (when (and (consp msg) (eq (first msg) :set-disabled))
       (add-patch (make-state-patch `(:components ,component-id :disabled) (second msg)))))))
;; This will return (make-update-result :patches patches :commands commands)

;;;--------------------------------------------------------------
;;; View
;;;--------------------------------------------------------------
(defmethod view ((component button) app-state &key id-path)
  (let* ((component-id (id-from-path id-path))
         (label (button-label app-state component))
         (disabled (button-disabled app-state component))
         ;; (is-focused (widget-focused-p app-state component-id)) ; Assuming widget-focused-p is available
         (is-focused (getf app-state (append id-path '(:focused)) nil)) ; Fallback to nil if not focused
         (base-class "button")
         (disabled-class (when disabled "button-disabled"))
         (focused-class (when is-focused "button-focused"))
         (all-classes (remove nil (list base-class disabled-class focused-class))))

    (make-styled-node
     :type :button
     :props (list :id component-id
                  :focusable t
                  :label label
                  :disabled disabled
                  ;; The :on-click prop in view usually maps to a message the component itself handles.
                  ;; The actual on-click-msg is handled in the update method.
                  ;; :on-click ,(unless disabled msg-button-click)
                  :class (format nil "~{~A~^ ~}" all-classes)
                  :aria-role "button"
                  :aria-disabled (if disabled "true" "false"))
     :children nil)))

