;;; Standardized Elm-style Label Widget
;;;===============================================================
(uiop:define-package :elmtui.ui.widgets.label
  (:use :cl :elmtui.ui.defcomponent )
  (:import-from :elmtui.ui.api
                #:id-from-path #:make-state-patch
                #:with-update-patch #:add-patch #:add-command
                )
  (:import-from :elmtui.state.msg :defmsg) ; For defining messages if needed
  (:import-from :elmtui.state.api #:app-state
                #:update-result #:make-update-result #:ur-patches #:ur-commands)
  (:import-from :elmtui.view.styled #:make-styled-node)
  (:export #:label #:make-label ; Class name and constructor
           ;; Accessors (generated by defcomponent)
           #:label-text #:label-for))

(in-package :elmtui.ui.widgets.label)

;; Define component with its state properties
(defcomponent label ()
    ((text :accessor label-text :initform "Label")
     (for :accessor label-for :initform nil :type (or null string symbol))))

;;;--------------------------------------------------------------
;;; Update (Labels are typically static, but could be updatable)
;;;--------------------------------------------------------------
(defmethod update ((component label) app-state msg &key id-path)
  (let ((component-id (id-from-path id-path)))
    (with-update-patch (app-state component)
      (when (and (consp msg) (eq (first msg) :set-text) (second msg))
        (add-patch (make-state-patch `(:components ,component-id :text) (second msg))))
      (when (and (consp msg) (eq (first msg) :set-for))
        (add-patch (make-state-patch `(:components ,component-id :for) (second msg))))))
  ;; This will return (make-update-result :patches patches :commands commands)
  )

;;;--------------------------------------------------------------
;;; View
;;;--------------------------------------------------------------
(defmethod view ((component label) app-state &key id-path)
  (let* ((component-id (id-from-path id-path))
         (text (label-text app-state component))
         (for-target (label-for app-state component))
         ;; Props like style, class, width, height, tooltip, aria-label
         ;; would ideally be passed into the view function or be part of the component's state
         ;; or be derived from the component's style-set after the apply-style phase.
         ;; For now, we construct a :drawable-content node directly.
         (props `(:id ,component-id
                  :text-content ,text
                  :aria-role "label" ;; Accessibility
                  ;; If 'for' is used, it might translate to aria-labelledby or similar,
                  ;; depending on how accessibility is handled for atomic nodes.
                  ;; For simplicity, we'll keep it as a potential custom attribute for now,
                  ;; or it could be used by a higher-level system.
                  ,@(when for-target `(:label-for ,for-target)))))
    (make-styled-node
     :type :drawable-content ;; Atomic type
     :props props
     ;; Labels typically don't have children in their direct visual representation
     :children nil)))

