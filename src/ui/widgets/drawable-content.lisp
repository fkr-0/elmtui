(uiop:define-package :elmtui.ui.widgets.drawable-content
  (:use :cl :alexandria)
  (:import-from :elmtui.ui.api #:component #:init #:update #:view #:make-state-patch #:id-from-path #:get-path #:normalize-update-args)
  (:import-from :elmtui.state.api #:make-update-result) ; For make-update-result
  ;; No direct view.styled import, as view returns data for renderer
  (:export
   #:drawable-content
   #:make-drawable-content
   #:msg-set-drawable-content
   #:msg-set-drawable-style
   ))
(in-package :elmtui.ui.widgets.drawable-content)

;;;---------------------------------------------------------------
;;; Drawable Content Component
;;;---------------------------------------------------------------
(defclass drawable-content (component)
  ()
  (:documentation "A component that represents directly renderable content, like a string of text.
Its state (content, style) is stored in the application state."))

(defun make-drawable-content (&key id)
  (make-instance 'drawable-content :id id))

;;;---------------------------------------------------------------
;;; Messages (Keywords)
;;;---------------------------------------------------------------
(defparameter msg-set-drawable-content :set-drawable-content)
(defparameter msg-set-drawable-style :set-drawable-style)

;;;---------------------------------------------------------------
;;; Component API Implementation (TEA-aligned)
;;;---------------------------------------------------------------
(defmethod init ((component drawable-content) &key id-path (initial-content "") initial-style &allow-other-keys)
  "Initializes the drawable-content component\'s state in the application-state.\
   Returns (values component patches commands)."
  (let ((component-id (id-from-path id-path)))
    (values component
            (list (make-state-patch `(:components ,component-id)
                                    `(:type ,(type-of component)
                                      :id ,component-id
                                      :content ,initial-content
                                      :style ,initial-style)))
            nil))) ; No initial commands

(defmethod update ((component drawable-content) message app-state &key id-path)
  "Handles messages to update the drawable-content\'s state.\
   Returns an update-result containing patches and commands."
  (multiple-value-bind (message state)
      (elmtui.ui.api:normalize-update-args message app-state)
    (declare (ignorable state)) ; State is used via get-path if needed, but direct access not typical here
  (let* ((component-id (id-from-path id-path))
         (component-state-path `(:components ,component-id))
         (patches nil)
         ;; (commands nil) ; No commands typically generated by this simple component
         )

    (cond
      ((and (consp message) (eq (car message) msg-set-drawable-content))
       (let ((new-content (cdr message)))
         (push (make-state-patch (append component-state-path '(:content)) new-content) patches)))
      ((and (consp message) (eq (car message) msg-set-drawable-style))
       (let ((new-style (cdr message))) ; new-style should be a plist or similar
         (push (make-state-patch (append component-state-path '(:style)) new-style) patches)))
      (t (warn "Drawable-content ~A received unhandled message: ~S" component-id message)))
    
    (make-update-result :patches (nreverse patches) :commands nil))))

(defmethod view ((component drawable-content) state &key id-path)
  "Generates a view model for the drawable-content component."
  (let* ((component-id (id-from-path id-path))
         (component-props (get-path `(:components ,component-id) state)))
    (unless component-props
      (warn "Drawable-content ~A state not found. Generating error view." component-id)
      (return-from view `(:error "Drawable-content state not found for ID: ~a" ,component-id)))
    
    `(:drawable-text ; Specific type for the renderer to identify as text content
      :id ,component-id
      :content (getf component-props :content "")
      :style (getf component-props :style nil))))

;; No specific width/height methods needed if layout engine handles it based on content + style
;; If intrinsic sizing is required before full layout, they could be added, but often
;; the renderer or layout engine computes this.
