+
+(defparameter *terminal-debug-backtraces* nil
+  "When non-nil, include a backtrace string in terminal debug events.")
+
+(defparameter *terminal-debug-phase* :normal
+  "Dynamic phase tag for terminal lifecycle/render debugging.")
+
+(defparameter *terminal-debug-owned-region* nil
+  "Dynamic owned terminal region for debug events.")
+
+(defparameter *terminal-debug-frame-id* nil
+  "Dynamic frame identifier for terminal debug events.")
+
+(defun clear-terminal-debug-events ()
+  "Clear accumulated terminal debug events."
+  (setf *terminal-debug-events* nil))
+
+(defun terminal-debug-events ()
+  "Return terminal debug events oldest first."
+  (nreverse (copy-list *terminal-debug-events*)))
+
+(defun %terminal-debug-backtrace-string ()
+  (with-output-to-string (s)
+    (uiop:print-backtrace :stream s)))
+
+(defun %normalize-terminal-region (region)
+  (cond
+    ((null region) nil)
+    ((and (listp region)
+          (or (null region) (keywordp (first region))))
+     region)
+    (t
+     (ignore-errors
+       (list :row (y region)
+             :col (x region)
+             :width (w region)
+             :height (h region))))))
+
+(defun log-terminal-event (kind &key source details region phase frame-id backtrace)
+  "Record and emit a structured terminal debug event."
+  (let* ((normalized-region (%normalize-terminal-region region))
+         (normalized-owned-region (%normalize-terminal-region *terminal-debug-owned-region*))
+         (event (list :kind kind
+                      :source source
+                      :phase (or phase *terminal-debug-phase*)
+                      :frame-id (or frame-id *terminal-debug-frame-id*)
+                      :region normalized-region
+                      :owned-region normalized-owned-region
+                      :details details
+                      :backtrace (when (or backtrace *terminal-debug-backtraces*)
+                                   (%terminal-debug-backtrace-string)))))
+    (push event *terminal-debug-events*)
+    (log-info "TERMINAL-EVENT ~S" event)
+    event))
 
