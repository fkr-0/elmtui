;;;; Maintained widget behavior through their public lifecycle and messages.
(defpackage :elmtui.tests.coverage-widgets
  (:use :cl :fiveam)
  (:local-nicknames (:lb :elmtui.ui.widgets.listbox)
                    (:sc :elmtui.ui.widgets.scrollable-container)
                    (:ti :elmtui.ui.widgets.textinput)
                    (:api :elmtui.ui.api)
                    (:st :elmtui.state.api))
  (:export #:coverage-widget-behavior-tests))
(in-package :elmtui.tests.coverage-widgets)
(def-suite coverage-widget-behavior-tests :in elmtui.tests:elmtui-test)
(in-suite coverage-widget-behavior-tests)

(defun node-props (node) (getf (rest node) :props))
(defun node-children (node) (getf (rest node) :children))
(defun list-view (model)
  (lb:view-listbox (list :choices model :current-focus-id :choices)
                   :widget-id :choices))
(defun list-step (model message) (lb:update-listbox message model))
(defun scroll-step (model message) (sc:update-scrollable-container message model))
(defun component-start (component path &rest args)
  (multiple-value-bind (instance patches commands)
      (apply #'api:init component :id-path path args)
    (declare (ignore instance))
    (is (null commands))
    (cl-state.patch:apply-patches (st:make-state) patches)))
(defun component-step (component state path message)
  (let ((result (api:update component message state :id-path path)))
    (is (typep result 'st:update-result))
    (cl-state.patch:apply-patches state (st:ur-patches result))))

(test listbox-navigation-keeps-selection-visible
  ;; A broken page step or scroll-follow rule changes the rendered item labels.
  (let* ((model (lb:init-listbox :choices :items '("a" "b" "c" "d" "e") :height 2))
         (next (list-step model '(:listbox-key-press :key :end)))
         (view (list-view next)))
    (is (null (lb:listbox-model-selected-index model)))
    (is (= 4 (lb:listbox-model-selected-index next)))
    (is (= 3 (lb:listbox-model-scroll-offset next)))
    (is (equal '("d" "e") (mapcar (lambda (n) (getf (node-props n) :value)) (node-children view))))
    (is (equal '(nil t) (mapcar (lambda (n) (getf (node-props n) :selected)) (node-children view))))
    (setf next (list-step next '(:listbox-key-press :key :page-up)))
    (is (= 2 (lb:listbox-model-selected-index next)))
    (is (= 2 (lb:listbox-model-scroll-offset next)))
    (setf next (list-step next '(:listbox-key-press :key :home)))
    (is (= 0 (lb:listbox-model-scroll-offset next)))
    (setf next (list-step next '(:listbox-key-press :key :page-down)))
    (is (= 2 (lb:listbox-model-selected-index next)))
    (is (= 1 (lb:listbox-model-scroll-offset next)))))

(test listbox-navigation-boundaries-and-aliases
  (dolist (entry '((:up 2) (:k 2) (:down 0) (:j 0) (:page-up 0) (:page-down 0)))
    (let ((model (lb:init-listbox :choices :items '("a" "b" "c") :height 2)))
      (setf model (list-step model (list :listbox-key-press :key (first entry))))
      (is (= (second entry) (lb:listbox-model-selected-index model)))))
  (let ((model (lb:init-listbox :choices :items '("a" "b") :selected-index 0)))
    (setf model (list-step model '(:listbox-key-press :key :up)))
    (is (= 0 (lb:listbox-model-selected-index model)))
    (setf model (list-step model '(:listbox-select-index :index 100)))
    (is (= 1 (lb:listbox-model-selected-index model)))
    (setf model (list-step model '(:listbox-select-index :index -3)))
    (is (= 0 (lb:listbox-model-selected-index model)))))

(test listbox-scroll-and-shrink
  (let ((model (lb:init-listbox :choices :items '("a" "b" "c" "d") :height 2)))
    (setf model (list-step model '(:listbox-scroll-down :amount 100)))
    (is (= 2 (lb:listbox-model-scroll-offset model)))
    (is (equal '("c" "d") (mapcar (lambda (n) (getf (node-props n) :value)) (node-children (list-view model)))))
    (setf model (list-step model '(:listbox-scroll-up :amount 100)))
    (is (= 0 (lb:listbox-model-scroll-offset model)))
    (setf model (list-step model '(:listbox-select-index :index 3)))
    (setf model (list-step model '(:listbox-set-items :items ("x"))))
    (is (= 0 (lb:listbox-model-selected-index model)))
    (is (= 0 (lb:listbox-model-scroll-offset model)))
    (is (string= "x" (getf (node-props (first (node-children (list-view model)))) :value)))))

(test listbox-empty-is-nonfocusable-and-navigation-is-noop
  (let ((model (lb:init-listbox :choices)))
    (dolist (key '(:up :down :home :end :page-up :page-down :enter))
      (multiple-value-bind (next commands) (list-step model (list :listbox-key-press :key key))
        (is (null commands))
        (is (null (lb:listbox-model-selected-index next)))))
    (let ((view (lb:view-listbox (list :choices model) :widget-id :choices :empty-text "Empty")))
      (is (null (getf (node-props view) :focusable)))
      (is (string= "Empty" (getf (rest (node-children view)) :content))))))

(test listbox-removing-all-items-clears-selection
  (let ((model (lb:init-listbox :choices :items '("a" "b") :selected-index 1 :height 1)))
    (setf model (list-step model '(:listbox-set-items :items nil)))
    (is (null (lb:listbox-model-selected-index model)))
    (is (= 0 (lb:listbox-model-scroll-offset model)))
    (setf model (list-step model '(:listbox-select-index :index 0)))
    (is (null (lb:listbox-model-selected-index model)))))

(test listbox-selection-command-and-repeat-noop
  (let* ((model (lb:init-listbox :choices :items '("a" "b") :on-select '(:picked)))
         (next nil))
    (multiple-value-bind (selected commands) (list-step model '(:listbox-select-index :index 1))
      (setf next selected)
      (is (= 1 (length commands))))
    (multiple-value-bind (same commands) (list-step next '(:listbox-select-index :index 1))
      (is (null commands))
      (is (= 1 (lb:listbox-model-selected-index same))))
    (multiple-value-bind (same commands) (list-step next '(:listbox-key-press :key :enter))
      (is (= 1 (length commands)))
      (is (= 1 (lb:listbox-model-selected-index same))))))

(test scrollable-clamps-deltas-and-dimension-shrink
  (let* ((model (sc:init-scrollable-container :sc :viewport-width 5 :viewport-height 3 :content-width 12 :content-height 10))
         (next (scroll-step model '(:scroll-container-scroll :delta-x 100 :delta-y 100))))
    (is (= 0 (sc:scrollable-container-model-scroll-top model)))
    (is (= 7 (sc:scrollable-container-model-scroll-top next)))
    (is (= 7 (sc:scrollable-container-model-scroll-left next)))
    (setf next (scroll-step next '(:scroll-container-set-scroll :x -10 :y -1)))
    (is (= 0 (sc:scrollable-container-model-scroll-top next)))
    (is (= 0 (sc:scrollable-container-model-scroll-left next)))
    (setf next (scroll-step next '(:scroll-container-key-press :key :end)))
    (setf next (scroll-step next '(:scroll-container-update-dimensions :content-width 2 :content-height 1)))
    (is (= 0 (sc:scrollable-container-model-scroll-top next)))
    (is (= 0 (sc:scrollable-container-model-scroll-left next)))))

(test scrollable-key-navigation-and-disabled-noop
  (let ((model (sc:init-scrollable-container :sc :viewport-width 3 :viewport-height 2 :content-width 10 :content-height 10)))
    (dolist (entry '((:down 0 1) (:j 0 2) (:right 1 2) (:l 2 2) (:up 2 1) (:k 2 0) (:left 1 0) (:h 0 0) (:page-down 0 2) (:page-up 0 0) (:end 7 8) (:home 0 0) (:unknown 0 0)))
      (setf model (scroll-step model (list :scroll-container-key-press :key (first entry))))
      (is (= (second entry) (sc:scrollable-container-model-scroll-left model)))
      (is (= (third entry) (sc:scrollable-container-model-scroll-top model)))))
  (let ((model (sc:init-scrollable-container :sc :disabled t)))
    (multiple-value-bind (next commands) (scroll-step model '(:scroll-container-scroll :delta-y 10))
      (is (eq model next))
      (is (null commands)))))

(test scrollable-view-preserves-children-and-overflow-policy
  (let* ((children '((:text :content "content")))
         (view (sc:view-scrollable-container nil :widget :sc :viewport-width 3 :viewport-height 2 :content-width 8 :content-height 1 :scroll-left 2 :children children :tooltip "Scroll" :aria-label "Content"))
         (props (node-props view)))
    (is (equal children (node-children view)))
    (is (= 2 (getf props :scroll-left)))
    (is (getf props :show-scrollbar-x))
    (is (null (getf props :show-scrollbar-y)))
    (is (getf props :focusable))
    (is (string= "Content" (getf props :aria-label))))
  (let* ((view (sc:view-scrollable-container nil :widget :sc :disabled t :show-scrollbar-x :never :show-scrollbar-y :always))
         (props (node-props view)))
    (is (null (getf props :show-scrollbar-x)))
    (is (getf props :show-scrollbar-y))
    (is (null (getf props :focusable)))))

(test textinput-public-editing-lifecycle
  (let* ((input (ti:make-textinput :id :entry))
         (path '(:components :entry))
         (state (component-start input path :initial-value "ac" :initial-cursor-pos 1)))
    (setf state (component-step input state path '(:textinput-key-press :key (:char #\b))))
    (is (string= "abc" (st:get-path '(:components :entry :value) state)))
    (is (= 2 (st:get-path '(:components :entry :cursor-pos) state)))
    (let ((view (api:view input state :id-path path)))
      (is (string= "abc" (getf (node-props view) :value))))))

(test native-component-view-participates-in-focus-traversal
  (let* ((input (ti:make-textinput :id :entry))
         (path '(:components :entry))
         (state (component-start input path :initial-value "abc"))
         (view (api:view input state :id-path path)))
    (is (equal '(:entry) (elmtui.core.focus:collect-focusable-ids view)))
    (is (equal '(:entry)
               (elmtui.core.focus:collect-focusable-ids
                (list :container :id :outer :children (list view)))))
    (setf state (component-step input state path '(:set-property :disabled t)))
    (is (null (elmtui.core.focus:collect-focusable-ids (api:view input state :id-path path))))))

(test viewport-offsets-clipping-and-children
  (let* ((viewport (elmtui.ui.widgets.viewport:make-viewport :id :panel))
         (path '(:components :panel))
         (state (component-start viewport path :initial-width 10 :initial-height 4)))
    (dolist (message '((:scroll-to :x 3 :y 2) (:scroll-by :dx 2 :dy 1) (:set-clipping :enabled t)))
      (setf state (component-step viewport state path message)))
    (let* ((children '((:text :content "inside")))
           (view (api:view viewport state :id-path path :children children))
           (style (getf (rest view) :style)))
      (is (= 3 (getf style :offset-x)))
      (is (= 2 (getf style :offset-y)))
      (is (= 2 (getf style :scroll-x)))
      (is (= 1 (getf style :scroll-y)))
      (is (eq :hidden (getf style :overflow)))
      (is (equal children (node-children view))))))

(test textinput-cursor-editing-and-boundaries
  (let* ((input (ti:make-textinput :id :entry))
         (path '(:components :entry))
         (state (component-start input path :initial-value "abc")))
    (flet ((key (symbol)
             (setf state (component-step input state path (list :textinput-key-press :key (list :key-sym symbol))))))
      (key :left)
      (key :backspace)
      (is (= 0 (st:get-path '(:components :entry :cursor-pos) state)))
      (key :end)
      (key :right)
      (key :delete)
      (is (= 3 (st:get-path '(:components :entry :cursor-pos) state)))
      (key :left)
      (key :backspace)
      (is (string= "ac" (st:get-path '(:components :entry :value) state)))
      (is (= 1 (st:get-path '(:components :entry :cursor-pos) state)))
      (key :delete)
      (is (string= "a" (st:get-path '(:components :entry :value) state)))
      (key :home)
      (is (= 0 (st:get-path '(:components :entry :cursor-pos) state)))
      (key :right)
      (is (= 1 (st:get-path '(:components :entry :cursor-pos) state))))))

(test textinput-disabled-submit-and-programmatic-value
  (let* ((input (ti:make-textinput :id :entry))
         (path '(:components :entry))
         (state (component-start input path :initial-value "locked" :initial-disabled t :initial-on-submit '(:save))))
    (dolist (message '((:textinput-key-press :key (:char #\x)) (:textinput-set-value :new-value "changed") :textinput-submit))
      (let ((result (api:update input message state :id-path path)))
        (is (null (st:ur-patches result)))
        (is (null (st:ur-commands result)))))
    (is (string= "locked" (st:get-path '(:components :entry :value) state)))
    (setf state (component-step input state path '(:set-property :disabled nil)))
    (setf state (component-step input state path '(:textinput-set-value :new-value "changed")))
    (is (string= "changed" (st:get-path '(:components :entry :value) state)))
    (is (= 7 (st:get-path '(:components :entry :cursor-pos) state)))
    (let ((result (api:update input '(:textinput-set-value :new-value "changed") state :id-path path)))
      (is (null (st:ur-patches result))))
    (dolist (message '(:textinput-submit (:textinput-key-press :key (:key-sym :enter))))
      (let ((result (api:update input message state :id-path path)))
        (is (equal '((:save)) (st:ur-commands result)))
        (is (null (st:ur-patches result)))))))

(test textinput-change-command-follows-value-not-cursor
  (let* ((input (ti:make-textinput :id :entry))
         (path '(:components :entry))
         (state (component-start input path :initial-value "ab" :initial-cursor-pos 100 :initial-on-change '(:changed))))
    (is (= 2 (st:get-path '(:components :entry :cursor-pos) state)))
    (dolist (message '((:textinput-key-press :key (:key-sym :home)) (:set-property :cursor-pos -10)))
      (let ((result (api:update input message state :id-path path)))
        (is (null (st:ur-commands result)))
        (setf state (cl-state.patch:apply-patches state (st:ur-patches result)))))
    (is (= 0 (st:get-path '(:components :entry :cursor-pos) state)))
    (let ((result (api:update input '(:textinput-key-press :key (:char #\x)) state :id-path path)))
      (is (equal '((:changed)) (st:ur-commands result)))
      (setf state (cl-state.patch:apply-patches state (st:ur-patches result))))
    (is (string= "xab" (st:get-path '(:components :entry :value) state)))
    (let ((result (api:update input '(:textinput-set-value :new-value "xab") state :id-path path)))
      (is (null (st:ur-commands result)))
      (is (null (st:ur-patches result))))))

(test scrollable-model-update-reaches-view
  (let* ((model (sc:init-scrollable-container :sc :viewport-width 3 :viewport-height 2 :content-width 8 :content-height 7))
         (next (scroll-step model '(:scroll-container-set-scroll :x 4 :y 3)))
         (view (sc:view-scrollable-container (list :sc next :current-focus-id :sc) :widget :sc :children '((:text :content "inside"))))
         (props (node-props view)))
    (is (= 4 (getf props :scroll-left)))
    (is (= 3 (getf props :scroll-top)))
    (is (= 8 (getf props :content-width)))
    (is (search "scrollable-container-focused" (getf props :class)))
    (is (getf props :show-scrollbar-x))
    (is (getf props :show-scrollbar-y))))

(test textinput-external-properties-reach-view
  (let* ((input (ti:make-textinput :id :entry))
         (path '(:components :entry))
         (state (component-start input path :initial-placeholder "Type here")))
    (dolist (message '((:set-property :placeholder "Search") (:set-property :value "query") (:set-property :cursor-pos 100)))
      (setf state (component-step input state path message)))
    (is (= 5 (st:get-path '(:components :entry :cursor-pos) state)))
    (let* ((view (api:view input state :id-path path))
           (props (node-props view)))
      (is (string= "query" (getf props :value)))
      (is (string= "Search" (getf props :placeholder))))
    (let ((result (api:update input '(:textinput-key-press :key (:key-sym :unknown)) state :id-path path)))
      (is (null (st:ur-patches result)))
      (is (null (st:ur-commands result))))))
