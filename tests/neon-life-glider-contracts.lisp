(uiop:define-package :elmtui.tests.neon-life-glider (:use :cl :fiveam) (:import-from :elmtui.state.api #:ur-patches) (:export #:neon-life-glider-tests))
(in-package :elmtui.tests.neon-life-glider)
(def-suite neon-life-glider-tests)
(in-suite neon-life-glider-tests)
(defun %patch-value (result property &optional default) (let ((entry (assoc (list property) (ur-patches result) :test #'equal))) (if entry (second entry) default)))
(test life-seed-and-population (let ((grid (elmtui.examples.neon-life:glider-grid))) (is (= 16 (array-dimension grid 0))) (is (= 36 (array-dimension grid 1))) (is (= 13 (elmtui.examples.neon-life:population grid))) (is (= 13 (elmtui.examples.neon-life:population (elmtui.examples.neon-life:next-generation grid))))))
(test life-blinker-period-two (let ((grid (make-array ' (7 7) :element-type 'bit :initial-element 0))) (setf (aref grid 3 2) 1 (aref grid 3 3) 1 (aref grid 3 4) 1) (let* ((first (elmtui.examples.neon-life:next-generation grid)) (second (elmtui.examples.neon-life:next-generation first))) (is (= 1 (aref first 2 3))) (is (= 1 (aref first 3 3))) (is (= 1 (aref first 4 3))) (is (= 0 (aref first 3 2))) (is (equalp grid second)))))
(test life-toroidal-corner-neighbors (let ((grid (make-array ' (5 5) :element-type 'bit :initial-element 0))) (setf (aref grid 4 4) 1 (aref grid 4 0) 1 (aref grid 0 4) 1) (is (= 3 (elmtui.examples.neon-life:count-neighbors grid 0 0))) (is (= 1 (aref (elmtui.examples.neon-life:next-generation grid) 0 0)))))
(test life-tick-pause-step-reset (let* ((s (elmtui.examples.neon-life:initial-state)) (tick (elmtui.examples.neon-life:life-update (list :tick) s)) (paused (copy-list s))) (is (= 1 (%patch-value tick :generation))) (setf (getf paused :running) nil) (is (null (ur-patches (elmtui.examples.neon-life:life-update :tick paused)))) (is (= 1 (%patch-value (elmtui.examples.neon-life:life-update (elmtui.core.event-types:make-key-event :key #\n :char #\n) paused) :generation))) (is (eq :neon-life-root (third (elmtui.examples.neon-life:life-view s))))))
(test glider-wall-reflections (multiple-value-bind (x y dx dy) (elmtui.examples.neon-glider:bounce-step 0 0 -1 -1 44 13) (is (= 1 x)) (is (= 1 y)) (is (= 1 dx)) (is (= 1 dy))) (multiple-value-bind (x y dx dy) (elmtui.examples.neon-glider:bounce-step 43 12 1 1 44 13) (is (= 42 x)) (is (= 11 y)) (is (= -1 dx)) (is (= -1 dy))))
(test glider-tick-and-trail (let* ((s (elmtui.examples.neon-glider:initial-state)) (tick (elmtui.examples.neon-glider:glider-update (list :tick) s))) (is (= 1 (%patch-value tick :tick))) (is (= 4 (%patch-value tick :x))) (is (= 8 (%patch-value tick :y))) (is (equal ' ((3 9)) (%patch-value tick :trail))) (setf (getf s :running) nil) (is (null (ur-patches (elmtui.examples.neon-glider:glider-update :tick s))))))
(test neon-native-viewports (let ((life (elmtui.examples.neon-life:life-view (elmtui.examples.neon-life:initial-state))) (glider (elmtui.examples.neon-glider:glider-view (elmtui.examples.neon-glider:initial-state)))) (is (equal :container (first life))) (is (equal :container (first glider))) (is (= 24 (length (getf (rest life) :children)))) (is (= 22 (length (getf (rest glider) :children))))))

