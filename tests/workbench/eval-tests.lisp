(defpackage :elmtui.workbench.eval.tests (:use :cl :fiveam :elmtui.workbench.eval) (:export #:eval-tests))
(in-package :elmtui.workbench.eval.tests)
(def-suite eval-tests)
(in-suite eval-tests)
(defun %await (session count) (loop with result = nil repeat 200 do (setf result (nconc result (poll-evaluation session))) (when (>= (count :finished result :key (lambda (x) (getf x :type))) count) (return-from %await result)) (sleep 0.01) finally (error "Timeout waiting for evaluations")))
(defun %matching (events id type) (remove-if-not (lambda (x) (and (equal (getf x :request-id) id) (eq (getf x :type) type))) events))
(defun %with-session (fn) (let ((s (make-repl-session))) (unwind-protect (funcall fn s) (close-repl-session s))))
(test evaluation-persists-definitions (%with-session (lambda (s) (request-evaluation s " (defparameter *wb-eval-x* 9) " :a) (%await s 1) (request-evaluation s " (defun wb-eval-add (n) (+ n *wb-eval-x*)) " :b) (%await s 1) (request-evaluation s " (wb-eval-add 33) " :c) (is (equal ' ("42") (mapcar (lambda (x) (getf x :text)) (%matching (%await s 1) :c :value)))))))
(test multiple-values-and-repl-history (%with-session (lambda (s) (request-evaluation s " (values 1 2 3) " :mv) (let ((events (%await s 1))) (is (equal ' ("1" "2" "3") (mapcar (lambda (x) (getf x :text)) (%matching events :mv :value)))) (is (equal ' (1 2 3) (mapcar (lambda (x) (getf x :index)) (%matching events :mv :value))))) (request-evaluation s " (list * /) " :hist) (is (equal ' ("(1 (1 2 3))") (mapcar (lambda (x) (getf x :text)) (%matching (%await s 1) :hist :value)))))))
(test package-and-readtable-survive-requests (%with-session (lambda (s) (request-evaluation s " (defpackage :wb-eval-scope (:use :cl)) (in-package :wb-eval-scope) " :switch) (%await s 1) (is (eq (find-package :wb-eval-scope) (repl-session-package s))) (request-evaluation s " (defparameter *session-v* 71) " :bind) (%await s 1) (request-evaluation s "*session-v*" :fetch) (is (equal ' ("71") (mapcar (lambda (x) (getf x :text)) (%matching (%await s 1) :fetch :value)))) (request-evaluation s " (set-macro-character #\\! (lambda (stream char) (declare (ignore stream char)) 99)) " :readmacro) (%await s 1) (request-evaluation s "!" :use-macro) (is (equal ' ("99") (mapcar (lambda (x) (getf x :text)) (%matching (%await s 1) :use-macro :value)))))))
(test captured-stdout-stderr (%with-session (lambda (s) (request-evaluation s " (progn (format t \"hello\") (format *error-output* \"warning\") (values)) " :streams) (let ((events (%await s 1))) (is (equal ' ("hello") (mapcar (lambda (x) (getf x :text)) (%matching events :streams :stdout)))) (is (equal ' ("warning") (mapcar (lambda (x) (getf x :text)) (%matching events :streams :stderr)))) (is (null (%matching events :streams :value)))))))
(test incomplete-and-partial-progress-recovery (%with-session (lambda (s) (request-evaluation s " (setf cl-user::*wb-eval-do-not-run* 98) '" :bad) (is (eq :error (getf (first (%matching (%await s 1) :bad :finished)) :status))) (request-evaluation s " (boundp 'cl-user::*wb-eval-do-not-run*) " :proof) (is (equal ' ("T") (mapcar (lambda (e) (getf e :text)) (%matching (%await s 1) :proof :value)))) (request-evaluation s " (error \"recoverable\") " :raise) (is (eq :error (getf (first (%matching (%await s 1) :raise :finished)) :status))) (request-evaluation s " (+ 3 4) " :after) (is (equal ' ("7") (mapcar (lambda (e) (getf e :text)) (%matching (%await s 1) :after :value)))))))
(test serialized-order-and-request-ids (%with-session (lambda (s) (request-evaluation s " (progn (sleep 0.05) :first) " :older) (request-evaluation s ":second" :newer) (let* ((events (%await s 2)) (finished (remove-if-not (lambda (x) (eq (getf x :type) :finished)) events))) (is (equal ' (:older :newer) (mapcar (lambda (x) (getf x :request-id)) finished))) (is (equal ' (":FIRST") (mapcar (lambda (x) (getf x :text)) (%matching events :older :value)))) (is (equal ' (":SECOND") (mapcar (lambda (x) (getf x :text)) (%matching events :newer :value)))) (is (null (poll-evaluation s)))) (signals error (request-evaluation s "3" :older)))))
(test cooperative-cancellation (%with-session (lambda (s) (request-evaluation s " (sleep 0.08) " :holding) (request-evaluation s " (setf cl-user::*wb-eval-cancelled* t) " :pending) (is (cancel-evaluation s :pending)) (let ((events (%await s 2))) (is (eq :aborted (getf (first (%matching events :pending :finished)) :status))) (is (= 1 (length (%matching events :pending :aborted)))) (is (null (%matching events :pending :value)))) (request-evaluation s " (boundp 'cl-user::*wb-eval-cancelled*) " :check) (is (equal ' ("NIL") (mapcar (lambda (e) (getf e :text)) (%matching (%await s 1) :check :value)))) (request-evaluation s " (sleep 0.04) " :running) (is (cancel-evaluation s :running)) (let ((events (%await s 1))) (is (eq :aborted (getf (first (%matching events :running :finished)) :status))) (is (null (%matching events :running :value)))) (is (not (cancel-evaluation s :missing))))))
(test cancelled-queued-reader-never-runs (%with-session (lambda (s) (request-evaluation s " (sleep 0.08) " :holding) (request-evaluation s "#. (setf cl-user::*wb-eval-reader-side-effect* :bad) " :reader) (is (cancel-evaluation s :reader)) (let ((events (%await s 2))) (is (eq :aborted (getf (first (%matching events :reader :finished)) :status))) (is (null (%matching events :reader :value)))) (request-evaluation s " (boundp 'cl-user::*wb-eval-reader-side-effect*) " :proof) (is (equal ' ("NIL") (mapcar (lambda (e) (getf e :text)) (%matching (%await s 1) :proof :value)))))))

