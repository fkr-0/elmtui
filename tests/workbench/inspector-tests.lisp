(defpackage :elmtui.workbench.inspector.tests (:use :cl :fiveam))
(in-package :elmtui.workbench.inspector.tests)
(def-suite inspector-tests)
(in-suite inspector-tests)
(test cyclic-object (let* ((s (elmtui.workbench.inspector:make-inspector-session)) (cell (cons 1 nil))) (setf (cdr cell) cell) (let* ((handle (elmtui.workbench.inspector:register-object s cell)) (answer (elmtui.workbench.inspector:inspect-object s handle :cycle)) (tree (getf answer :object)) (cycle (getf (getf (second (getf tree :children)) :value) :cycle))) (is (eq :ok (getf answer :status))) (is (not (null cycle))))))
(test lazy-refresh-and-pagination (let* ((s (elmtui.workbench.inspector:make-inspector-session)) (base (elmtui.workbench.inspector:snapshot-image s 1 :section :packages)) (name (symbol-name (gensym "WB04-TEST-")))) (unwind-protect (progn (make-package name) (is (= (getf base :total) (getf (elmtui.workbench.inspector:snapshot-image s 1 :section :packages) :total))) (let ((fresh (elmtui.workbench.inspector:snapshot-image s 1 :section :packages :refresh t :page-size 1))) (is (= (1+ (getf base :total)) (getf fresh :total))) (is (= 1 (length (getf fresh :entries)))) (is (getf fresh :has-more)))) (when (find-package name) (delete-package name)))))
(test unbound-symbols-are-not-lexical (let* ((s (elmtui.workbench.inspector:make-inspector-session)) (name (symbol-name (gensym "WB04-SYMBOLS-"))) (pkg (make-package name))) (unwind-protect (progn (intern "UNBOUND-TEST" pkg) (let* ((snap (elmtui.workbench.inspector:snapshot-image s 9 :section :symbols :package name)) (row (find "UNBOUND-TEST" (getf snap :entries) :key (lambda (r) (getf r :name)) :test #'string=))) (is (not (null row))) (is (eq :global-or-special (getf row :binding))) (is (not (getf row :boundp))))) (delete-package pkg))))
(test asdf-inventory (let* ((i (elmtui.workbench.inspector:make-inspector-session)) (r (elmtui.workbench.inspector:snapshot-image i 1 :section :asdf-systems))) (is (eq :ok (getf r :status))) (is (every (lambda (entry) (stringp (getf entry :name))) (getf r :entries)))))
(defclass noisy-object () ())
(defvar *printed* 0)
(defmethod print-object ((obj noisy-object) stream) (declare (ignore obj stream)) (incf *printed*))
(test passive-selection-is-read-only (let* ((*printed* 0) (s (elmtui.workbench.inspector:make-inspector-session)) (handle (elmtui.workbench.inspector:register-object s (make-instance 'noisy-object))) (result (elmtui.workbench.inspector:inspect-object s handle :selected))) (is (eq :ok (getf result :status))) (is (zerop *printed*))))
(test invalid-request-recovers (let ((s (elmtui.workbench.inspector:make-inspector-session))) (signals error (elmtui.workbench.inspector:snapshot-image s 1 :section :symbols :package 42)) (is (eq :ok (getf (elmtui.workbench.inspector:snapshot-image s 1 :section :packages) :status)))))
(test interrupted-request (let* ((session (elmtui.workbench.inspector:make-inspector-session)) (cancelled (elmtui.workbench.inspector:snapshot-image session 20 :request-id :interrupt :interrupted t))) (is (eq :interrupted (getf cancelled :status))) (is (eq :interrupt (getf cancelled :request-id))) (is (null (elmtui.workbench.inspector:inspector-session-generation session))) (is (eq :ok (getf (elmtui.workbench.inspector:snapshot-image session 20) :status)))))
(defvar *watch-value* 1)
(test variable-watches-are-live-and-mark-changes (let ((session (elmtui.workbench.inspector:make-inspector-session))) (setf *watch-value* 1) (elmtui.workbench.inspector:watch-variable session '*watch-value*) (let* ((first (elmtui.workbench.inspector:snapshot-image session 1 :section :watches)) (row (first (getf first :entries)))) (is (eq :ok (getf first :status))) (is (getf row :boundp)) (is (not (getf row :changed))) (is (string= "1" (getf row :preview))) (is (eq :watch (getf row :style-role)))) (setf *watch-value* 2) (let* ((changed (elmtui.workbench.inspector:snapshot-image session 1 :section :watches)) (row (first (getf changed :entries)))) (is (getf row :changed)) (is (string= "2" (getf row :preview))) (is (eq :watch-changed (getf row :style-role)))) (let* ((steady (elmtui.workbench.inspector:snapshot-image session 1 :section :watches)) (row (first (getf steady :entries)))) (is (not (getf row :changed))) (is (eq :watch (getf row :style-role))))))
(test variable-watch-management-and-unbound-state (let* ((session (elmtui.workbench.inspector:make-inspector-session)) (unbound (gensym "WB04-UNBOUND-"))) (elmtui.workbench.inspector:watch-variable session unbound) (elmtui.workbench.inspector:watch-variable session unbound) (is (= 1 (length (elmtui.workbench.inspector:watched-variables session)))) (let ((row (first (getf (elmtui.workbench.inspector:snapshot-image session 4 :section :watches) :entries)))) (is (not (getf row :boundp))) (is (string= "<unbound>" (getf row :preview))) (is (eq :watch-unbound (getf row :style-role)))) (elmtui.workbench.inspector:unwatch-variable session unbound) (is (null (elmtui.workbench.inspector:watched-variables session))) (elmtui.workbench.inspector:watch-variable session '*watch-value*) (elmtui.workbench.inspector:clear-watches session) (is (null (elmtui.workbench.inspector:watched-variables session)))))
(test inspector-query-filters-live-watches (let ((session (elmtui.workbench.inspector:make-inspector-session))) (elmtui.workbench.inspector:watch-variable session '*watch-value*) (elmtui.workbench.inspector:watch-variable session '*printed*) (let* ((snapshot (elmtui.workbench.inspector:snapshot-image session 6 :section :watches :query "watch-value")) (rows (getf snapshot :entries))) (is (= 1 (length rows))) (is (search "WATCH-VALUE" (getf (first rows) :name))))))
(test inspector-theme-exposes-semantic-watch-styles (let ((theme (elmtui.workbench.inspector:make-inspector-theme))) (let ((changed (elmtui.workbench.inspector:inspector-style theme :watch-changed)) (unbound (elmtui.workbench.inspector:inspector-style theme :watch-unbound))) (is (eq :yellow (getf changed :fg-color))) (is (getf changed :bold)) (is (eq :gray (getf unbound :fg-color))))))
(test symbol-and-string-previews-respect-strict-cap (let* ((s (elmtui.workbench.inspector:make-inspector-session :max-preview 32 :max-items 3)) (long-name (make-string 4096 :initial-element #\X)) (sym (make-symbol long-name)) (handle (elmtui.workbench.inspector:register-object s sym)) (tree (getf (elmtui.workbench.inspector:inspect-object s handle :symbol-cap) :object)) (pkg (make-package (symbol-name (gensym "WB04-LIMIT-"))))) (unwind-protect (progn (is (<= (length (getf tree :preview)) 32)) (intern long-name pkg) (let* ((snap (elmtui.workbench.inspector:snapshot-image s 1 :section :symbols :package (package-name pkg))) (row (first (getf snap :entries)))) (is (not (null row))) (is (<= (length (getf row :name)) 32))) (elmtui.workbench.inspector:watch-variable s sym) (let* ((snap (elmtui.workbench.inspector:snapshot-image s 2 :section :watches)) (row (first (getf snap :entries)))) (is (not (null row))) (is (<= (length (getf row :name)) 32)) (is (<= (length (getf row :id)) 32)))) (delete-package pkg))))

