;;;; Observable backend frames, ANSI transitions and deterministic input/output.
(defpackage :elmtui.tests.coverage-backends
  (:use :cl :fiveam)
  (:local-nicknames (:api :elmtui.platform.api)
                    (:ansi :elmtui.platform.backend.common.ansi-styling)
                    (:term :elmtui.platform.backend.terminal)
                    (:vb :elmtui.platform.backend.common.virtual-buffer)
                    (:fake :elmtui.backend.faketerm)))
(in-package :elmtui.tests.coverage-backends)
(def-suite coverage-backend-behavior-tests :in elmtui.tests:elmtui-test)
(in-suite coverage-backend-behavior-tests)

(defun sgr (parameters) (format nil "~C[~Am" #\Escape parameters))
(defun file-bytes (path)
  (with-open-file (in path :element-type '(unsigned-byte 8))
    (let ((bytes (make-array (file-length in) :element-type '(unsigned-byte 8))))
      (read-sequence bytes in) bytes)))
(defun byte-text (path) (sb-ext:octets-to-string (file-bytes path) :external-format :utf-8))
(defmacro with-fake ((name &key (width 6) (height 4)) &body body)
  `(uiop:with-temporary-file (:pathname path)
     (let ((,name (api:initialize-backend :faketerm :filepath path :width ,width :height ,height)))
       (unwind-protect (progn ,@body) (api:shutdown-backend ,name)))))

(test color-tokens-emit-the-specified-ansi-values
  (dolist (entry '((:red "31") (:bright-blue "94") (:gray "90")
                   (0 "38;5;0") (255 "38;5;255") ((:256 42) "38;5;42")
                   ((42) "38;5;42") ((:red) "31")
                   ((:rgb 1 2 3) "38;2;1;2;3") ((1 2 3) "38;2;1;2;3")
                   ((:rgba 1 2 3 0.4) "38;2;1;2;3") ("#010203" "38;2;1;2;3")
                   ((:hsl 0 100 50) "38;2;255;0;0")
                   ((:hsl 60 100 50) "38;2;255;255;0")
                   ((:hsl 120 100 50) "38;2;0;255;0")
                   ((:hsl 180 100 50) "38;2;0;255;255")
                   ((:hsl 240 100 50) "38;2;0;0;255")
                   ((:hsl 300 100 50) "38;2;255;0;255")))
    (let ((color (ansi:fuzz-color (first entry))))
      (is (string= (sgr (second entry)) (ansi::to-ansi-seq color)))
      (is (eq color (ansi:fuzz-color color)))))
  (is (string= (sgr "48;2;1;2;3") (ansi::to-ansi-seq (ansi:fuzz-color '(1 2 3) t))))
  (is (string= (sgr "49") (ansi::to-ansi-seq nil :bg t)))
  (is (string= (sgr "39") (ansi::to-ansi-seq (ansi:make-terminal-color))))
  (is-false (ansi:fuzz-color '(:unknown 1)))
  (signals error (ansi::to-ansi-seq :unknown)))

(test style-attribute-transitions-and-resets
  (dolist (entry '((:bold "1" "22") (:italic "3" "23") (:underline "4" "24")
                   (:faint "2" "22") (:blink "5" "25") (:inverse "7" "27")
                   (:strike "9" "29") (:invisible "8" "28")))
    (destructuring-bind (key on off) entry
      (let ((current (ansi:make-terminal-style))
            (desired (ansi:make-terminal-style)))
        (ansi:terminal-style-kv desired key t)
        (is-false (elmtui.view.geo:=? current desired))
        (is (equal (list (list key t)) (ansi:update-style! current desired)))
        (is (equal (list (sgr on)) (ansi:ansi-seqs current key)))
        (is-false (ansi:update-style! current desired))
        (is (equal (list (list key nil)) (ansi:update-style! current nil)))
        (is (equal (list (sgr off)) (ansi:ansi-seqs current key))))))
  (signals error (ansi:terminal-style-kv (ansi:make-terminal-style) :unsupported t)))

(test style-aliases-override-legacy-attributes-and-copy-colors
  (let* ((style (ansi:style-to-terminal-style
                 '(:foreground-color (:rgb 1 2 3) :background-color (:256 9)
                   :attributes (:bold :italic :underline :faint :blink :inverse :strike :invisible)
                   :bold nil)))
         (copy (ansi:deep-copy-style style)))
    (is-false (ansi:terminal-style-bold style))
    (is-true (ansi:terminal-style-invisible style))
    (is (equal '(1 2 3) (ansi:terminal-style-fg-color-val style)))
    (is (= 9 (ansi:terminal-style-bg-color-val style)))
    (is-true (elmtui.view.geo:=? style copy))
    (setf (ansi::terminal-color-red (ansi:terminal-style-fg-color copy)) 100)
    (is (= 1 (ansi::terminal-color-red (ansi:terminal-style-fg-color style))))
    (is-false (elmtui.view.geo:=? style copy))
    (is-true (getf (ansi:as-plist style) :underline)))
  (let* ((original '(:fg (1 2 3))) (copy (ansi:deep-copy-style original)))
    (setf (first (getf copy :fg)) 99)
    (is (= 1 (first (getf original :fg)))))
  (is-false (ansi:deep-copy-style nil)))

(test terminal-byte-output-encodes-all-utf8-lengths
  (uiop:with-temporary-file (:pathname path :stream out :direction :output :element-type '(unsigned-byte 8))
    (term:write-output "Aé界🙂" out)
    (finish-output out)
    (is (equalp #(65 195 169 231 149 140 240 159 153 130) (file-bytes path)))))

(test terminal-style-output-is-incremental-and-reversible
  (uiop:with-temporary-file (:pathname path :stream out :direction :output :element-type '(unsigned-byte 8))
    (let ((backend (term::make-terminal-instance :stream out)))
      (api:apply-style backend '(:fg-color (:rgb 1 2 3) :bold t :invisible t))
      (finish-output out)
      (let ((first (file-position out)))
        (is (search (sgr "38;2;1;2;3") (byte-text path)))
        (is (search (sgr "8") (byte-text path)))
        (api:apply-style backend '(:fg-color (:rgb 1 2 3) :bold t :invisible t))
        (is (= first (file-position out))))
      (api:apply-style backend nil)
      (finish-output out)
      (is (search (sgr "39") (byte-text path)))
      (is (search (sgr "22") (byte-text path)))
      (is (search (sgr "28") (byte-text path))))))

(test terminal-cursor-and-scroll-control-stream
  (uiop:with-temporary-file (:pathname path :stream out :direction :output :element-type '(unsigned-byte 8))
  (let* (
         (backend (term::make-terminal-instance :stream out :width 8 :height 3)))
    (api:set-cursor-position backend 1 2)
    (is (equal '(1 2) (multiple-value-list (api:get-cursor-position backend))))
    (api:hide-cursor backend)
    (is-false (term:terminal-instance-cursor-visible-p backend))
    (api:show-cursor backend)
    (is-true (term:terminal-instance-cursor-visible-p backend))
    (api:scroll backend 2)
    (api:scroll-lines backend -1)
    (api:scroll-lines backend 0)
    (is (= 1 (term::terminal-instance-scrolled-lines backend)))
    (api:clear-below-cursor backend)
    (api:flush-output backend)
    (let ((text (byte-text path)))
      (dolist (sequence '("[2;3H" "[?25l" "[?25h" "[2S" "[1T" "[0J"))
        (is (search sequence text)))))))

(test terminal-scroll-preserves-device-and-stream-direction
  (let* ((device (cl-inputs.device.api:make-device :faketerm :width 3 :height 3))
         (backend (term::make-terminal-instance :cl-device device)))
    (unwind-protect
         (progn
           (cl-inputs.terminal.api:draw-char-at device 0 0 #\A)
           (cl-inputs.terminal.api:draw-char-at device 1 0 #\B)
           (cl-inputs.terminal.api:draw-char-at device 2 0 #\C)
           (api:scroll-lines backend 1)
           ;; Advancing viewport down moves content up, making space below.
           (is (equal '("B" "C" "") (cl-inputs.device.faketerm:faketerm-screen-lines device)))
           (api:scroll-lines backend -1)
           (is (equal '("" "B" "C") (cl-inputs.device.faketerm:faketerm-screen-lines device))))
      (cl-inputs.device.api:close-device device))))

(test terminal-styled-border-retains-style-without-color-override
  (let* ((buffer (vb:make-virtual-buffer 4 3))
         (backend (term::make-terminal-instance)))
    (api:draw-styled-box backend buffer 0 0 3 4 :border-style :single
                         :style '(:fg :green :attrs (:bold)))
    (let ((style (vb:buffer-cell-style (vb:buffer-cell-at buffer 0 0))))
      (is (eq :green (ansi:terminal-style-fg-color-val style)))
      (is-true (ansi:terminal-style-bold style)))))

(test terminal-virtual-drawing-box-style-clear-and-resize
  (let* ((out (make-string-output-stream))
         (buffer (vb:make-virtual-buffer 6 4))
         (backend (term::make-terminal-instance :stream out :width 6 :height 4
                                               :front-buffer (vb:make-virtual-buffer 6 4) :back-buffer buffer)))
    (api:draw-box-outline backend buffer 0 0 4 6 :style '(:fg :green))
    (is (char= #\+ (vb:buffer-cell-char (vb:buffer-cell-at buffer 0 0))))
    (is (char= #\| (vb:buffer-cell-char (vb:buffer-cell-at buffer 2 5))))
    (api:fill-rectangle backend buffer 1 1 2 4 :char #\x :style '(:fg :red))
    (api:draw-text-at backend buffer 1 2 "hi" :style '(:fg :cyan))
    (is (char= #\h (vb:buffer-cell-char (vb:buffer-cell-at buffer 1 2))))
    (api:set-cell-style backend buffer 1 2 :style '(:bold t))
    (is (ansi:terminal-style-bold (vb:buffer-cell-style (vb:buffer-cell-at buffer 1 2))))
    (api:clear-area backend buffer 2 1 1 4)
    (is (char= #\Space (vb:buffer-cell-char (vb:buffer-cell-at buffer 2 2))))
    (api:draw-styled-box backend buffer 0 0 4 6 :border-style :double :border-color :red)
    (is (char= #\╔ (vb:buffer-cell-char (vb:buffer-cell-at buffer 0 0))))
    (api:clear-screen backend)
    (is (char= #\Space (vb:buffer-cell-char (vb:buffer-cell-at buffer 0 0))))
    (api:handle-backend-resize backend 9 2)
    (is (equal '(9 2) (multiple-value-list (api:get-screen-dimensions backend))))
    (is (= 9 (vb:buffer-width (term::terminal-instance-back-buffer backend))))
    (is (string= "" (get-output-stream-string out)))))

(test faketerm-clips-drawing-and-clears-only-requested-region
  (with-fake (backend)
    (api:fill-rectangle backend nil -1 -1 3 4 :char #\x)
    (is (equal '("xxx   " "xxx   " "      " "      ") (fake:faketerm-screen-lines backend)))
    (api:draw-text-at backend nil 3 4 "abc")
    (is (string= "    ab" (fourth (fake:faketerm-screen-lines backend))))
    (api:clear-area backend nil -1 1 3 2)
    (is (equal '("x     " "x     " "      " "    ab") (fake:faketerm-screen-lines backend)))
    (api:clear-screen backend (elmtui.view.geo:make-rectangle
                              :pos (elmtui.view.geo:make-pos :x 0 :y 0)
                              :size (elmtui.view.geo:make-size :w 1 :h 2)))
    (is (string= "      " (first (fake:faketerm-screen-lines backend))))
    (is-false (fake:get-char-at-faketerm backend -1 0))
    (is-false (fake:get-cell-style-faketerm backend 0 6))))

(test faketerm-styled-border-restores-caller-style
  (with-fake (backend)
    (api:apply-style backend '(:fg :green :bg :black :attrs (:bold)))
    (api:draw-styled-box backend nil 0 0 4 6 :border-style :single :border-color :red)
    (is (equal '("┌────┐" "│    │" "│    │" "└────┘") (fake:faketerm-screen-lines backend)))
    (is (eq :red (getf (fake:get-cell-style-faketerm backend 0 0) :fg)))
    (api:draw-char-at backend nil 1 1 #\x)
    (is (eq :green (getf (fake:get-cell-style-faketerm backend 1 1) :fg)))))

(test faketerm-cell-restyling-preserves-character-and-isolation
  (with-fake (backend)
    (api:draw-char-at backend nil 1 1 #\x :style '(:fg :red))
    (api:set-cell-style backend nil 1 1 :style '(:fg :cyan :attrs (:underline)))
    (is (char= #\x (fake:get-char-at-faketerm backend 1 1)))
    (is (eq :cyan (getf (fake:get-cell-style-faketerm backend 1 1) :fg)))
    (is (equal '(:underline) (getf (fake:get-cell-style-faketerm backend 1 1) :attrs)))
    (is (eq :white (getf (fake:get-cell-style-faketerm backend 1 2) :fg)))
    (api:handle-backend-resize backend 8 2)
    (api:set-cell-style backend nil 0 0 :style '(:fg :blue))
    (is-false (equal (fake:get-cell-style-faketerm backend 0 0)
                     (fake:get-cell-style-faketerm backend 0 1)))))
