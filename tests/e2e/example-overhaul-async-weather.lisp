(in-package :cl-user)
(defun %wx-test (name thunk) (funcall thunk) (format t "PASS ~A~%" name))
(%wx-test "url-and-coordinates" (lambda () (assert (search "M%C3%BCnchen%20%26%20Co" (elmtui.examples.async-weather:weather-geocode-url "München & Co"))) (assert (string= (elmtui.examples.async-weather:weather-url-encode "A B/C") "A%20B%2FC")) (assert (elmtui.examples.async-weather::%coordinates "52.52,13.40")) (assert (null (elmtui.examples.async-weather::%coordinates "999,13.4"))) (assert (null (elmtui.examples.async-weather::%coordinates "abc,13.4")))))
(%wx-test "json-fixtures" (lambda () (let ((places (elmtui.examples.async-weather:weather-parse-geocodes "{\"results\":[{\"name\":\"München\",\"country\":\"Germany\",\"latitude\":48.13,\"longitude\":11.57},{\"name\":\"Munich\",\"country\":\"USA\",\"latitude\":42.1,\"longitude\":-83.2}]}")) (wx (elmtui.examples.async-weather:weather-parse-forecast "{\"current\":{\"temperature_2m\":16.2,\"relative_humidity_2m\":65,\"apparent_temperature\":14,\"weather_code\":3,\"wind_speed_10m\":9.5},\"hourly\":{\"time\":[\"2026-10-09T08:00\"],\"temperature_2m\":[16.2],\"precipitation_probability\":[50]}}"))) (assert (= (length places) 2)) (assert (string= (getf (first places) :name) "München")) (assert (string= (getf wx :temperature) "16.2")) (assert (= 1 (length (getf wx :hours)))) (assert (handler-case (progn (elmtui.examples.async-weather:weather-parse-geocodes "{\"results\":[]}") nil) (error () t))) (assert (handler-case (progn (elmtui.examples.async-weather:weather-parse-forecast "{}") nil) (error () t))) (assert (handler-case (progn (elmtui.examples.async-weather:weather-parse-geocodes "{broken") nil) (error () t))))))
(%wx-test "teastart-disambiguate-ready" (lambda () (let ((elmtui.examples.async-weather:*weather-transport* (lambda (&rest args) (declare (ignore args)) nil))) (multiple-value-bind (a cmds) (elmtui.examples.async-weather:weather-init) (assert (eq (getf a :phase) :queued)) (assert (= (length cmds) 1)) (assert (eq (first (elmtui.examples.async-weather:weather-view a)) :root-viewport)) (let ((id (getf a :generation))) (multiple-value-bind (b commands) (elmtui.examples.async-weather:weather-update (list :weather-result :generation id :stage :geocode :value (list (list :name "Berlin" :country "Germany" :lat "52.5" :lon "13.4") (list :name "Berlin" :country "USA" :lat "39.9" :lon "-84.4"))) a) (assert (null commands)) (assert (eq (getf b :phase) :selecting)) (multiple-value-bind (c other) (elmtui.examples.async-weather:weather-update (list :keyevent :key :down) b) (declare (ignore other)) (assert (= (getf c :selected) 1)) (multiple-value-bind (d forecast-cmd) (elmtui.examples.async-weather:weather-update (list :keyevent :key :enter) c) (assert (eq (getf d :phase) :fetching)) (assert (= 1 (length forecast-cmd))) (multiple-value-bind (e none) (elmtui.examples.async-weather:weather-update (list :weather-result :generation id :stage :forecast :value (list :temperature "17" :hours ' (("08:00" "17" "10")))) d) (assert (null none)) (assert (eq (getf e :phase) :ready)) (assert (string= (getf (getf e :weather) :temperature) "17")))))))))))
(%wx-test "stale-and-cancel-ignored" (lambda () (let ((state (list :phase :geocoding :stage :geocode :generation :new :city "Berlin")) (cancelled (list :phase :cancelled :stage :geocode :generation :new :city "Berlin"))) (assert (eq state (nth-value 0 (elmtui.examples.async-weather:weather-update ' (:weather-result :generation :old :stage :geocode :value nil) state)))) (assert (eq cancelled (nth-value 0 (elmtui.examples.async-weather:weather-update ' (:weather-result :generation :new :stage :geocode :value nil) cancelled)))))))
(%wx-test "refresh-cancels-prior" (lambda () (multiple-value-bind (state commands) (elmtui.examples.async-weather:weather-init) (declare (ignore commands)) (multiple-value-bind (new commands2) (elmtui.examples.async-weather:weather-update ' (:keyevent :char #\r) state) (assert (eq (getf new :phase) :queued)) (assert (= 1 (length commands2))) (assert (not (eq (getf state :generation) (getf new :generation))))))))
(%wx-test "ignore-late-ready" (lambda () (let ((state (list :generation :g :stage :forecast :phase :ready))) (assert (eq state (nth-value 0 (elmtui.examples.async-weather:weather-update ' (:weather-progress :generation :g :stage :forecast) state)))))))
(%wx-test "offline-and-retry" (lambda () (multiple-value-bind (state cmds) (elmtui.examples.async-weather:weather-init) (declare (ignore cmds)) (let ((failed (nth-value 0 (elmtui.examples.async-weather:weather-update (list :weather-error :generation (getf state :generation) :stage :geocode :detail "offline") state)))) (assert (eq :error (getf failed :phase))) (assert (eq :queued (getf (nth-value 0 (elmtui.examples.async-weather:weather-update ' (:keyevent :char #\r) failed)) :phase)))))))
