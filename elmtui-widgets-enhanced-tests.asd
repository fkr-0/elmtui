(asdf:defsystem "elmtui-widgets-enhanced-tests" :version "0.2.0" :description "Focused tests for optional enhanced ElmTUI widgets" :depends-on (#:elmtui-widgets-enhanced/experimental #:fiveam) :pathname "./tests/" :serial t :components ((:file "enhanced-widgets-tests")) :perform (test-op (op c) (declare (ignore op c)) (symbol-call :elmtui.tests.enhanced-widgets :run-enhanced-widget-tests)))
