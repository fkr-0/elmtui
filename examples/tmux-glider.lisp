(eval-when (:compile-toplevel :load-toplevel :execute) (unless (find-package :elmtui.examples.tmux-slider) (load (merge-pathnames #P"tmux-slider.lisp" (or *load-truename* *compile-file-truename*)))))
(uiop:define-package :elmtui.examples.tmux-glider (:use :cl) (:import-from :elmtui.platform.tmux #:tmux-available-p) (:export #:run-tmux-glider #:initial-grid #:life-step #:population))
(in-package :elmtui.examples.tmux-glider)
(defun population (grid) (loop for y below (array-dimension grid 0) sum (loop for x below (array-dimension grid 1) count (= 1 (aref grid y x)))))
(defun initial-grid (width height) (let ((grid (make-array (list height width) :element-type 'bit :initial-element 0)) (x (max 1 (floor (- width 3) 2))) (y (max 0 (- height 6)))) (dolist (offset ' ((1 2) (0 1) (2 0) (1 0) (0 0))) (let ((cx (+ x (first offset))) (cy (+ y (second offset)))) (when (and (< cx width) (< cy height)) (setf (aref grid cy cx) 1)))) grid))
(defun life-step (grid) (let* ((height (array-dimension grid 0)) (width (array-dimension grid 1)) (next (make-array (list height width) :element-type 'bit :initial-element 0))) (dotimes (y height) (dotimes (x width) (let ((neighbors 0)) (loop for dy from -1 to 1 do (loop for dx from -1 to 1 do (unless (and (zerop dx) (zerop dy)) (let ((nx (+ x dx)) (ny (+ y dy))) (when (and (<= 0 nx) (< nx width) (<= 0 ny) (< ny height)) (incf neighbors (aref grid ny nx))))))) (setf (aref next y x) (if (or (= neighbors 3) (and (= neighbors 2) (= 1 (aref grid y x)))) 1 0))))) next))
(defun %bounds (grid) (let ((xmin (array-dimension grid 1)) (xmax -1)) (dotimes (y (array-dimension grid 0)) (dotimes (x (array-dimension grid 1)) (when (= 1 (aref grid y x)) (setf xmin (min xmin x) xmax (max xmax x))))) (values xmin xmax)))
(defun %reflect-x (grid) (multiple-value-bind (xmin xmax) (%bounds grid) (let ((out (make-array (array-dimensions grid) :element-type 'bit :initial-element 0))) (dotimes (y (array-dimension grid 0)) (dotimes (x (array-dimension grid 1)) (when (= 1 (aref grid y x)) (setf (aref out y (- (+ xmin xmax) x)) 1)))) out)))
(defun %advance (grid direction) (multiple-value-bind (xmin xmax) (%bounds grid) (let* ((width (array-dimension grid 1)) (bounce (or (and (< direction 0) (<= xmin 1)) (and (> direction 0) (>= xmax (- width 2))))) (ready (if bounce (%reflect-x grid) grid))) (values (life-step ready) (if bounce (- direction) direction)))))
(defun %live-points (grid) (loop for y below (array-dimension grid 0) append (loop for x below (array-dimension grid 1) when (= 1 (aref grid y x)) collect (list x y))))
(defun %color-sgr (color background) (when color (elmtui.platform.backend.common.ansi-styling::to-ansi-seq color :bg background)))
(defun %emit-style (style) (format t "~C[0m" #\Escape) (when style (let ((fg (getf style :fg)) (bg (getf style :bg)) (attrs (getf style :attrs))) (when fg (write-string (%color-sgr fg nil))) (when bg (write-string (%color-sgr bg t))) (dolist (attr attrs) (let ((code (case attr (:bold 1) (:dim 2) (:italic 3) (:underline 4) (:blink 5) (:inverse 7) (:strike 9) (otherwise nil)))) (when code (format t "~C[~Dm" #\Escape code)))))))
(defun %draw-point (snapshot point live) (let* ((x (first point)) (y (second point)) (cell (aref (getf snapshot :cells) y x))) (format t "~C[~D;~DH" #\Escape (1+ y) (1+ x)) (if live (progn (format t "~C[0;1;38;2;97;255;211;48;2;26;77;86m" #\Escape) (write-char #\█)) (progn (%emit-style (cdr cell)) (write-char (car cell))))))
(defun %draw-difference (snapshot before after) (let ((old (if before (%live-points before) nil)) (new (if after (%live-points after) nil))) (dolist (pt old) (unless (member pt new :test #'equal) (%draw-point snapshot pt nil))) (dolist (pt new) (unless (member pt old :test #'equal) (%draw-point snapshot pt t))) (format t "~C8" #\Escape) (finish-output)))
(defun %run-overlay (snapshot speed frames) (let* ((grid (initial-grid (getf snapshot :width) (getf snapshot :height))) (direction -1) (generation 0) (visible nil) (paused nil) (saved-tty (sb-posix:tcgetattr 0)) (working-tty (sb-posix:tcgetattr 0))) (setf (sb-posix:termios-lflag working-tty) (logand (sb-posix:termios-lflag working-tty) (lognot (logior sb-posix:icanon sb-posix:echo)))) (format t "~C7" #\Escape) (finish-output) (unwind-protect (progn (sb-posix:tcsetattr 0 sb-posix:tcsanow working-tty) (%draw-difference snapshot nil grid) (setf visible grid) (loop while (plusp (population grid)) do (sleep (if paused 0.04 speed)) (let ((key (when (listen *standard-input*) (read-char *standard-input* nil nil)))) (when key (case key ((#\q #\Q) (return)) ((#\Space #\p #\P) (setf paused (not paused))) ((#\r #\R) (%draw-difference snapshot grid nil) (setf grid (initial-grid (getf snapshot :width) (getf snapshot :height)) visible grid direction -1 generation 0) (%draw-difference snapshot nil grid)) (otherwise nil))) (when (or (not paused) (and key (member key ' (#\n #\N)))) (multiple-value-bind (next dir) (%advance grid direction) (%draw-difference snapshot grid next) (setf grid next visible next direction dir) (incf generation) (when (and frames (>= generation frames)) (return))))))) (%draw-difference snapshot visible nil) (sb-posix:tcsetattr 0 sb-posix:tcsanow saved-tty) (format t "~C8" #\Escape) (finish-output))))
(defun run-tmux-glider (&key (backend-type :terminal) (speed 0.12) frames) "Walk a real five-cell Conway glider over tmux text without clearing it." (unless (eq backend-type :terminal) (error "The tmux glider needs the real terminal backend.")) (unless (tmux-available-p) (format *error-output* "tmux-glider requires a live tmux pane; no terminal state was changed.~%") (return-from run-tmux-glider nil)) (let ((snapshot (elmtui.examples.tmux-slider::%capture-styled-pane))) (unless snapshot (format *error-output* "tmux-glider could not snapshot the styled underlay; terminal untouched.~%") (return-from run-tmux-glider nil)) (%run-overlay snapshot (max 0.035 (min 0.5 speed)) frames)))
