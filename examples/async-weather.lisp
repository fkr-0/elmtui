(uiop:define-package :elmtui.examples.async-weather (:use :cl) (:import-from :elmtui.app #:defapplication) (:import-from :elmtui.core.async #:cmd-async) (:import-from :elmtui.core.event-types #:key-event #:key-event-key #:key-event-char) (:import-from :elmtui.state.api #:make-update-result #:state-ref) (:export #:run-async-weather #:weather-init #:weather-update #:weather-view #:weather-url-encode #:weather-geocode-url #:weather-forecast-url #:weather-parse-geocodes #:weather-parse-forecast #:*weather-transport*))
(in-package :elmtui.examples.async-weather)
(defparameter *weather-city* "Berlin")
(defparameter *weather-transport* nil)
(defparameter *weather-tokens* (make-hash-table :test 'eq))
(defparameter *weather-lock* (bt:make-lock "weather-request-lock"))
(defstruct weather-token (cancelled-p nil) process (stage nil))
(defun %safe-text (value &optional (limit 100)) (let ((text (if (stringp value) value (princ-to-string value)))) (subseq (coerce (loop for c across text unless (or (< (char-code c) 32) (= (char-code c) 127) (<= 128 (char-code c) 159)) collect c) 'string) 0 (min limit (length (coerce (loop for c across text unless (or (< (char-code c) 32) (= (char-code c) 127) (<= 128 (char-code c) 159)) collect c) 'string))))))
(defun weather-url-encode (text) (with-output-to-string (out) (loop for octet across (sb-ext:string-to-octets text :external-format :utf-8) do (if (or (<= 65 octet 90) (<= 97 octet 122) (<= 48 octet 57) (member octet ' (45 46 95 126))) (write-char (code-char octet) out) (format out "%~2,'0X" octet)))))
(defun weather-geocode-url (city) (format nil "https://geocoding-api.open-meteo.com/v1/search?name=~A&count=5&language=en&format=json" (weather-url-encode city)))
(defun weather-forecast-url (lat lon) (format nil "https://api.open-meteo.com/v1/forecast?latitude=~A&longitude=~A&current=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m&hourly=temperature_2m,precipitation_probability&forecast_days=2&timezone=auto" lat lon))
(defun %rows (text) (remove "" (uiop:split-string text :separator ' (#\Newline)) :test #'string=))
(defun %fields (line) (uiop:split-string line :separator ' (#\Tab)))
(defun %number-text-p (text &optional (signed t)) (and (stringp text) (plusp (length text)) (< (length text) 30) (every (lambda (c) (or (digit-char-p c) (char= c #\.) (and signed (char= c #\-)))) text) (handler-case (let ((*read-eval* nil)) (let ((value (read-from-string text nil nil))) (and (realp value) (not (complexp value))))) (error () nil))))
(defun %coordinate-p (lat lon) (and (%number-text-p lat) (%number-text-p lon) (<= -90 (read-from-string lat) 90) (<= -180 (read-from-string lon) 180)))
(defun %jq (json expression) (with-input-from-string (input json) (uiop:run-program (list "jq" "-r" "-r" expression) :input input :output :string :error-output :string)))
(defun weather-parse-geocodes (json) (let ((text (%jq json "if (.results | type) == \"array\" then .results[] | select ((.name|type) ==\"string\" and (.country|type) ==\"string\" and (.latitude|type) ==\"number\" and (.longitude|type) ==\"number\") | [.name,.country,.latitude,.longitude] | @tsv else empty end"))) (let ((places (loop for row in (%rows text) for fields = (%fields row) when (and (= (length fields) 4) (%coordinate-p (third fields) (fourth fields))) collect (list :name (%safe-text (first fields) 80) :country (%safe-text (second fields) 80) :lat (third fields) :lon (fourth fields))))) (or places (error "No matching locations found")))))
(defun weather-parse-forecast (json) (let* ((head (%fields (string-trim ' (#\Newline) (%jq json "if (.current|type) ==\"object\" and (.current.temperature_2m|type) ==\"number\" and (.current.relative_humidity_2m|type) ==\"number\" and (.current.apparent_temperature|type) ==\"number\" and (.current.weather_code|type) ==\"number\" and (.current.wind_speed_10m|type) ==\"number\" then [.current.temperature_2m,.current.relative_humidity_2m,.current.apparent_temperature,.current.weather_code,.current.wind_speed_10m] | @tsv else error (\"missing current data\") end")))) (hour-data (%jq json ".hourly | [.time[0:8],.temperature_2m[0:8],.precipitation_probability[0:8]] | transpose[] | @tsv")) (hours (loop for row in (%rows hour-data) for parts = (%fields row) when (= (length parts) 3) collect (mapcar (lambda (x) (%safe-text x 40)) parts)))) (unless (and (= (length head) 5) (every #'%number-text-p head) hours) (error "Malformed weather values")) (list :temperature (first head) :humidity (second head) :feels (third head) :code (fourth head) :wind (fifth head) :hours hours)))
(defun %register-token (id) (bt:with-lock-held (*weather-lock*) (setf (gethash id *weather-tokens*) (make-weather-token))))
(defun %token-live-p (id) (bt:with-lock-held (*weather-lock*) (let ((token (gethash id *weather-tokens*))) (and token (not (weather-token-cancelled-p token))))))
(defun %cancel-token (id) (bt:with-lock-held (*weather-lock*) (let ((token (gethash id *weather-tokens*))) (when token (setf (weather-token-cancelled-p token) t) (when (weather-token-process token) (ignore-errors (uiop:terminate-process (weather-token-process token) :urgent t)) (setf (weather-token-process token) nil)) (remhash id *weather-tokens*)))))
(defun %curl (url id) (unless (%token-live-p id) (error "Request cancelled")) (let ((proc (uiop:launch-program (list "curl" "--silent" "--show-error" "--fail-with-body" "--connect-timeout" "4" "--max-time" "10" "--max-filesize" "524288" "--proto" "=https" "--max-redirs" "0" url) :output :stream :error-output :stream :ignore-error-status t))) (unwind-protect (progn (bt:with-lock-held (*weather-lock*) (let ((token (gethash id *weather-tokens*))) (if (and token (not (weather-token-cancelled-p token))) (setf (weather-token-process token) proc) (uiop:terminate-process proc :urgent t)))) (let* ((body (with-output-to-string (output) (loop repeat 524289 for char = (read-char (uiop:process-info-output proc) nil nil) while char do (write-char char output)))) (code (uiop:wait-process proc))) (unless (%token-live-p id) (error "Request cancelled")) (unless (and (eql code 0) (<= (length body) 524288)) (error "HTTP request failed or exceeded bounds, curl exit ~A" code)) body)) (when (uiop:process-alive-p proc) (ignore-errors (uiop:terminate-process proc :urgent t))) (bt:with-lock-held (*weather-lock*) (let ((token (gethash id *weather-tokens*))) (when (and token (eq (weather-token-process token) proc)) (setf (weather-token-process token) nil)))))))
(defun %fetch (url filter id) (let ((body (%curl url id))) (ecase filter (:geocode (weather-parse-geocodes body)) (:forecast (weather-parse-forecast body)))))
(defun %token-stage-p (id phase) (bt:with-lock-held (*weather-lock*) (let ((token (gethash id *weather-tokens*))) (and token (eq phase (weather-token-stage token))))))
(defun %command (id phase url &optional transport-override) (let ((transport (or transport-override *weather-transport* #'%fetch))) (bt:with-lock-held (*weather-lock*) (let ((token (gethash id *weather-tokens*))) (when token (setf (weather-token-stage token) phase)))) (cmd-async (lambda (progress) (funcall progress (list :weather-progress :generation id :stage phase)) (funcall transport url phase id)) :on-complete (lambda (result) (list :weather-result :generation id :stage phase :value result)) :on-error (lambda (condition) (list :weather-error :generation id :stage phase :detail (%safe-text (princ-to-string condition) 140))) :timeout 14 :cancellation-fn (lambda () (when (%token-stage-p id phase) (%cancel-token id))))))
(defun %key (message) (cond ((typep message 'key-event) (values (key-event-key message) (key-event-char message))) ((and (consp message) (member (first message) ' (:keyevent :key-event))) (values (getf (rest message) :key) (getf (rest message) :char))) (t (values nil nil))))
(defun %matches (key char wanted) (or (eql key wanted) (and (characterp char) (characterp wanted) (char-equal char wanted)) (and (characterp key) (characterp wanted) (char-equal key wanted))))
(defun %patch (model &rest updates) (let ((next (copy-list model))) (loop for (key value) on updates by #'cddr do (setf (getf next key) value)) next))
(defun %coordinates (text) (let ((fields (uiop:split-string text :separator ' (#\,)))) (when (and (= 2 (length fields)) (%coordinate-p (string-trim ' (#\Space) (first fields)) (string-trim ' (#\Space) (second fields)))) (mapcar (lambda (x) (string-trim ' (#\Space) x)) fields))))
(defun %start (model &optional new-city) (let* ((city (string-trim ' (#\Space #\Tab) (or new-city (getf model :city) "Berlin"))) (id (gensym "WX-")) (coordinates (%coordinates city)) (stage (if coordinates :forecast :geocode))) (when (getf model :generation) (%cancel-token (getf model :generation))) (if (zerop (length city)) (values (%patch model :phase :error :status "City cannot be empty") nil) (progn (%register-token id) (values (%patch model :city city :generation id :phase :queued :stage stage :selected 0 :choices nil :input-mode nil :input "" :error nil :location (if coordinates city (getf model :location)) :status "Request queued") (list (%command id stage (if coordinates (weather-forecast-url (first coordinates) (second coordinates)) (weather-geocode-url city)) (getf model :transport))))))))
(defun weather-init () (let ((model (list :city *weather-city* :generation nil :phase :queued :stage nil :selected 0 :choices nil :weather nil :location nil :input-mode nil :input "" :status "Queued" :error nil :should-quit nil :transport *weather-transport*))) (%start model)))
(defun %choose (model choice) (let ((id (getf model :generation))) (values (%patch model :location (format nil "~A, ~A" (getf choice :name) (getf choice :country)) :phase :fetching :stage :forecast :choices nil :selected 0 :status "Fetching current and hourly conditions") (list (%command id :forecast (weather-forecast-url (getf choice :lat) (getf choice :lon)) (getf model :transport))))))
(defun %transition-message (message model) (let ((kind (first message)) (id (getf (rest message) :generation)) (stage (getf (rest message) :stage))) (if (or (not (eq id (getf model :generation))) (getf model :should-quit) (member (getf model :phase) ' (:cancelled :ready :error :selecting)) (not (eq stage (getf model :stage)))) (values model nil) (case kind (:weather-progress (values (%patch model :phase (if (eq stage :geocode) :geocoding :fetching) :status (if (eq stage :geocode) "Resolving location via Open-Meteo" "Downloading weather via Open-Meteo")) nil)) (:weather-error (%cancel-token id) (values (%patch model :phase :error :error (getf (rest message) :detail) :status "Request failed; press r to retry") nil)) (:weather-result (if (eq stage :geocode) (let ((places (getf (rest message) :value))) (cond ((null places) (values (%patch model :phase :error :status "No locations found") nil)) ((= (length places) 1) (%choose model (first places))) (t (values (%patch model :phase :selecting :choices places :selected 0 :status "Choose a location with arrows and Enter") nil)))) (progn (%cancel-token id) (values (%patch model :phase :ready :weather (getf (rest message) :value) :status "Updated from Open-Meteo") nil)))) (otherwise (values model nil))))))
(defun %handle-keys (message model) (multiple-value-bind (key char) (%key message) (let ((phase (getf model :phase)) (choices (getf model :choices)) (selected (getf model :selected 0))) (cond ((or (and (not (getf model :input-mode)) (%matches key char #\q)) (member key ' (:escape :esc))) (if (and (getf model :input-mode) (member key ' (:escape :esc))) (values (%patch model :input-mode nil :status "City entry dismissed") nil) (progn (%cancel-token (getf model :generation)) (values (%patch model :phase :cancelled :should-quit t :status "Leaving weather dashboard") nil)))) ((getf model :input-mode) (cond ((member key ' (:enter :return)) (if (zerop (length (string-trim ' (#\Space) (getf model :input)))) (values (%patch model :status "Enter a nonempty city") nil) (%start model (getf model :input)))) ((member key ' (:backspace :delete)) (let ((old (getf model :input))) (values (%patch model :input (if (plusp (length old)) (subseq old 0 (1- (length old))) "")) nil))) ((and char (graphic-char-p char) (< (length (getf model :input)) 80)) (values (%patch model :input (concatenate 'string (getf model :input) (string char))) nil)) (t (values model nil)))) ((%matches key char #\/) (values (%patch model :input-mode t :input (getf model :city) :status "Edit city or latitude,longitude then Enter") nil)) ((%matches key char #\r) (%start model)) ((%matches key char #\c) (%cancel-token (getf model :generation)) (values (%patch model :phase :cancelled :status "Request cancelled; press r to refresh") nil)) ((and (eq phase :selecting) (member key ' (:up :arrow-up) :test #'eq)) (values (%patch model :selected (max 0 (1- selected))) nil)) ((and (eq phase :selecting) (member key ' (:down :arrow-down) :test #'eq)) (values (%patch model :selected (min (1- (length choices)) (1+ selected))) nil)) ((and (eq phase :selecting) (member key ' (:enter :return) :test #'eq)) (%choose model (nth selected choices))) (t (values model nil))))))
(defun weather-update (message model) (cond ((equal message ' (:weather-bootstrap)) (if (null (getf model :stage)) (%start model) (values model nil))) ((and (consp message) (member (first message) ' (:weather-progress :weather-result :weather-error))) (%transition-message message model)) ((equal message ' (:app-quit-requested)) (%cancel-token (getf model :generation)) (values (%patch model :should-quit t :phase :cancelled) nil)) (t (%handle-keys message model))))
(defun %weather-row (id content role) (let ((fg (case role (:title ' (110 230 255)) (:border ' (169 119 247)) (:accent ' (255 199 129)) (:ready ' (101 243 199)) (:error ' (255 112 150)) (:muted ' (141 155 183)) (otherwise ' (224 232 255)))) (bg (if (eq role :title) ' (18 30 57) ' (10 16 30)))) (list :text :id id :content (%safe-text content 70) :style (list :width 72 :height 1 :bold (member role ' (:title :accent :ready)) :fg-color fg :bg-color bg))))
(defun %weather-lines (model) (let* ((phase (getf model :phase)) (weather (getf model :weather)) (location (%safe-text (or (getf model :location) (getf model :city)) 50)) (stale (and weather (not (eq phase :ready)))) (choices (getf model :choices)) (selected (getf model :selected 0)) (hours (getf weather :hours))) (append (list (cons " OPEN METEO / ASYNC WEATHER LAB 09" :title) (cons "+---------------------------------------------------------------------+" :border) (cons (format nil " LOCATION ~A" location) :accent) (cons (format nil " STATUS ~A" (string-upcase (symbol-name phase))) (if (eq phase :error) :error :ready)) (cons (format nil " ~A" (getf model :status)) :muted) (cons (if stale " STALE DATA / showing previous successful update" " LIVE DATA / no background polling") (if stale :error :muted)) (cons (if weather (format nil " ~A C / ~A WMO" (getf weather :temperature) (getf weather :code)) " --.- C / awaiting response") :title) (cons (if weather (format nil " FEELS ~A C HUMIDITY ~A % WIND ~A km/h" (getf weather :feels) (getf weather :humidity) (getf weather :wind)) " FEELS -- HUMIDITY -- WIND --") :accent) (cons " HOURLY / TEMP C / RAIN %" :border)) (cond ((eq phase :selecting) (loop for choice in choices for i from 0 collect (cons (format nil " ~A ~A, ~A ~A / ~A" (if (= i selected) ">" " ") (getf choice :name) (getf choice :country) (getf choice :lat) (getf choice :lon)) (if (= i selected) :accent :body)))) (hours (loop for row in (subseq hours 0 (min 6 (length hours))) collect (cons (format nil " ~A ~A C ~A %%" (first row) (second row) (third row)) :body))) (t (list (cons " -- -- --" :muted)))) (list (cons "+---------------------------------------------------------------------+" :border) (cons (if (getf model :input-mode) (format nil " CITY > ~A_" (getf model :input)) " r refresh / change city c cancel q/Esc quit") :accent) (cons (if (eq phase :selecting) " Up/Down choose city; Enter confirms" " Powered by Open-Meteo / data subject to service availability") :muted)))))
(defun weather-view (model) (let* ((lines (%weather-lines model)) (children (loop for (value . role) in lines for index from 0 collect (%weather-row (intern (format nil "WX-ROW-~D" index) :keyword) value role)))) (list :root-viewport :id :weather-root :anchor :below-cursor :width 74 :height (min 23 (max 14 (length lines))) :blank-on-exit t :child-dsl-spec (list :container :id :weather-container :style (list :display :flex :flex-direction :column :width 74 :height (length lines) :gap 0 :padding 0) :children children))))
(defparameter +weather-state-keys+ ' (:city :generation :phase :stage :selected :choices :weather :location :input-mode :input :status :error :transport :should-quit))
(defun weather-app-init () (list :city *weather-city* :generation nil :phase :queued :stage nil :selected 0 :choices nil :weather nil :location nil :input-mode nil :input "" :status "Waiting to start" :error nil :should-quit nil :transport *weather-transport*))
(defun weather-app-state (state) (loop for key in +weather-state-keys+ append (list key (state-ref state key))))
(defun weather-app-update (message app-state) (let ((original (weather-app-state app-state))) (multiple-value-bind (next commands) (weather-update message original) (make-update-result :patches (loop for key in +weather-state-keys+ unless (equal (getf next key) (getf original key)) collect (list (list key) (getf next key))) :commands commands))))
(defun weather-app-view (state) (getf (rest (weather-view (weather-app-state state))) :child-dsl-spec))
(defun weather-app-subscriptions (state) (when (and (eq (state-ref state :phase) :queued) (null (state-ref state :stage))) ' (:timer (:interval 0.2 :message (:weather-bootstrap)))))
(defapplication weather-dashboard :root-viewport-id :weather-root :root-component-dsl ' (:root-viewport :id :weather-root :anchor :below-cursor :width 74 :height 23 :blank-on-exit t :overflow-policy :scroll :child-dsl-spec (:view nil)) :initial-state-fn #'weather-app-init :update-fn #'weather-app-update :view-fn #'weather-app-view :subscriptions-fn weather-app-subscriptions)
(defun run-async-weather (&key (city "Berlin") (backend-type :terminal) platform-options argv help) (declare (ignorable argv)) (when (or help (member "--help" argv :test #'string=)) (format t "ElmTUI async-weather: query Open-Meteo geocoding and forecast.~%Usage: ./scripts/examples.sh run async-weather~%Controls: r refresh, / change city or enter LAT,LON, c cancel, arrows/Enter select, q/Esc quit.~%Requires curl and jq; network required except with an injected transport.~%") (return-from run-async-weather nil)) (let ((*weather-city* city)) (run-weather-dashboard :platform backend-type :platform-options platform-options)))
